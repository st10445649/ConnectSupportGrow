@{
    ViewBag.Title = "Watch Recording - AAC Basics";
}

<section class="bg-white border-b border-gray-200 py-4">
    <div class="container mx-auto px-4">
        <a href="/dashboard" class="text-primary-600 hover:text-primary-700 font-semibold text-sm">← Back to Dashboard</a>
        <h1 class="text-2xl font-bold text-gray-900 mt-2">AAC (Augmentative & Alternative Communication) Basics</h1>
    </div>
</section>

<section class="py-12 bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4 max-w-5xl">
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Main Content -->
            <div class="lg:col-span-2">
                
                <!-- Video Player -->
                <div class="bg-black rounded-lg overflow-hidden shadow-lg mb-6 relative">
                    
                    <!-- Video Player -->
                     
                    <img src="~/images/webinars/dyslexia.jpg" 
                         alt="Autism Spectrum Awareness Banner" 
                        class="w-full h-48 sm:h-64 md:h-80 lg:h-96 object-cover" />
                
                    
                    <!-- Offline Badge -->
                    <div id="offline-badge" style="display: none;" class="absolute top-4 right-4 bg-yellow-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
                        Playing from cache
                    </div>
                </div>
                
                <!-- Video Info -->
                <div class="bg-white rounded-lg shadow p-6 mb-6">
                    <div class="flex items-start justify-between mb-4">
                        <div>
                            <h2 class="text-2xl font-bold text-gray-900">AAC Basics</h2>
                            <p class="text-gray-600 text-sm mt-1">Recorded June 28, 2026 · 120 minutes</p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-gray-600 font-semibold">Access expires</p>
                            <p class="text-lg font-bold text-primary-600">July 28, 2026</p>
                        </div>
                    </div>
                    
                    <p class="text-gray-700 leading-relaxed mb-6">
                        Introduction to augmentative and alternative communication (AAC) systems and how to implement 
                        them effectively in school and clinical settings. Learn about no-tech, low-tech, and high-tech solutions.
                    </p>
                    
                    <!-- Download Button -->
                    <button class="px-6 py-2 bg-secondary-500 text-white rounded-lg hover:bg-secondary-600 font-semibold flex items-center gap-2">
                        ⬇ Download Recording (MP4)
                    </button>
                </div>
                
                <!-- Video Controls -->
                <div class="bg-white rounded-lg shadow p-6">
                    <h3 class="text-lg font-bold text-gray-900 mb-4">Video Controls</h3>
                    
                    <div class="space-y-3">
                        <button class="w-full p-3 border border-gray-300 rounded-lg hover:bg-gray-50 text-left font-semibold text-gray-900 flex items-center gap-2">
                            View Transcript
                        </button>
                        <button class="w-full p-3 border border-gray-300 rounded-lg hover:bg-gray-50 text-left font-semibold text-gray-900 flex items-center gap-2">
                            Save Bookmark
                        </button>
                       
                    </div>
                </div>
            </div>
            
            <!-- Sidebar -->
            <div class="lg:col-span-1">
                
                <!-- Watch Progress -->
                <div class="bg-white rounded-lg shadow p-6 mb-6">
                    <h3 class="text-lg font-bold text-gray-900 mb-4">Your Progress</h3>
                    <div class="w-full bg-gray-200 rounded-full h-3 mb-3">
                        <div class="bg-primary-500 h-3 rounded-full" style="width: 65%"></div>
                    </div>
                    <p class="text-sm text-gray-700">65% watched · Continue from 1:18:30</p>
                </div>
                
                <!-- Learning Materials -->
                <div class="bg-white rounded-lg shadow p-6 mb-6">
                    <h3 class="text-lg font-bold text-gray-900 mb-4">Materials</h3>
                    <div class="space-y-2">
                        <a href="#" class="block p-3 bg-gray-50 rounded hover:bg-gray-100 text-primary-600 font-semibold text-sm">
                            Presentation Slides
                        </a>
                        <a href="#" class="block p-3 bg-gray-50 rounded hover:bg-gray-100 text-primary-600 font-semibold text-sm">
                            AAC Resources List
                        </a>
                        <a href="#" class="block p-3 bg-gray-50 rounded hover:bg-gray-100 text-primary-600 font-semibold text-sm">
                            Tool Recommendations
                        </a>
                    </div>
                </div>
                
                <!-- Evaluation -->
                <div class="gradient-primary border rounded-lg p-6">
                    <h3 class="font-bold text-gray-900 mb-2">✓ Attended & Completed</h3>
                    <p class="text-sm text-gray-700 mb-4">
                        You've finished this webinar. Share your feedback with us!
                    </p>
                    <a href="/dashboard/createevaluations" class="block w-full py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-semibold text-center">
                        Leave Feedback
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Anti-Piracy Script -->
<script>
// Disable right-click
document.addEventListener('contextmenu', e => e.preventDefault());

// Disable DevTools
document.addEventListener('keydown', e => {
    if (e.key === 'F12' || (e.ctrlKey && e.shiftKey && e.key === 'I') || (e.ctrlKey && e.shiftKey && e.key === 'J')) {
        e.preventDefault();
    }
});

// Detect offline
window.addEventListener('offline', () => document.getElementById('offline-badge').style.display = 'block');
window.addEventListener('online', () => document.getElementById('offline-badge').style.display = 'none');
</script>
