@using ConnectGrow.Services
@model ConnectGrow.Controllers.DashboardViewModel
@{
    ViewBag.Title = "My Dashboard";
    var firstName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                    ?? User.Identity?.Name
                    ?? "there";

    var attendedCount = Model.Past.Count(b => b.AttendanceConfirmed);
}

<section class="gradient-primary py-12 md:py-16">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-2">
            Welcome back, @firstName!
        </h1>
        <p class="text-lg text-gray-700">
            Here's an overview of your learning journey
        </p>
    </div>
</section>

@if (TempData["Message"] is string successMessage)
{
    <div class="container mx-auto px-4 mt-6">
        <div role="status" class="bg-green-50 border border-green-200 rounded-lg p-4 text-green-800">
            @successMessage
        </div>
    </div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="container mx-auto px-4 mt-6">
        <div role="alert" class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-800">
            @errorMessage
        </div>
    </div>
}

@if (ViewBag.Error is not null)
{
    <div class="container mx-auto px-4 mt-6">
        <div role="alert" class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-800">
            We couldn't load your bookings just now. @ViewBag.Error
        </div>
    </div>
}

<section class="py-8">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">

            @* CPD counts only confirmed attendance — points are earned by
               attending, not by paying, and overstating them would have people
               submitting numbers they cannot support. *@
            <div class="bg-white rounded-lg shadow p-6 border-l-4 border-primary-500">
                <p class="text-gray-600 text-sm font-semibold mb-2">Total CPD Points</p>
                <p class="text-4xl font-bold text-primary-600">@Model.TotalCpdPoints</p>
                <p class="text-xs text-gray-500 mt-2">from confirmed attendance</p>
            </div>

            <div class="bg-white rounded-lg shadow p-6 border-l-4 border-secondary-500">
                <p class="text-gray-600 text-sm font-semibold mb-2">Upcoming Bookings</p>
                <p class="text-4xl font-bold text-secondary-600">@Model.UpcomingCount</p>
                <p class="text-xs text-gray-500 mt-2">
                    @(Model.UpcomingCount == 1 ? "session booked" : "sessions booked")
                </p>
            </div>

            <div class="bg-white rounded-lg shadow p-6 border-l-4 border-accent-500">
                <p class="text-gray-600 text-sm font-semibold mb-2">Webinars Attended</p>
                <p class="text-4xl font-bold text-accent-600">@attendedCount</p>
                <p class="text-xs text-gray-500 mt-2">attendance confirmed</p>
            </div>

            <div class="bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
                <p class="text-gray-600 text-sm font-semibold mb-2">Feedback Due</p>
                <p class="text-4xl font-bold text-green-600">@Model.AwaitingEvaluation.Count</p>
                <p class="text-xs text-gray-500 mt-2">evaluations to complete</p>
            </div>
        </div>
    </div>
</section>

<section class="py-8 bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4">

        <div x-data="{ activeTab: 'upcoming' }" class="space-y-6">

            <div class="flex gap-2 bg-white rounded-lg p-2 shadow border border-gray-200 overflow-x-auto">
                <button x-on:click="activeTab = 'upcoming'"
                    :class="activeTab === 'upcoming' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 px-4 py-2 rounded font-semibold transition-smooth whitespace-nowrap">
                    Upcoming (@Model.UpcomingCount)
                </button>
                <button x-on:click="activeTab = 'past'"
                    :class="activeTab === 'past' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 px-4 py-2 rounded font-semibold transition-smooth whitespace-nowrap">
                    Past (@Model.PastCount)
                </button>
                <button x-on:click="activeTab = 'recordings'"
                    :class="activeTab === 'recordings' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 px-4 py-2 rounded font-semibold transition-smooth whitespace-nowrap">
                    Recordings
                </button>
                <button x-on:click="activeTab = 'cpd'"
                    :class="activeTab === 'cpd' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 px-4 py-2 rounded font-semibold transition-smooth whitespace-nowrap">
                    CPD Points
                </button>
            </div>

            <div x-show="activeTab === 'upcoming'" class="space-y-4">

                @if (!Model.Upcoming.Any())
                {
                    <div class="bg-white rounded-lg shadow p-12 text-center">
                        <p class="text-xl text-gray-700 mb-4">You have no upcoming webinars.</p>
                        <a asp-area="" asp-controller="Webinars" asp-action="Index"
                           class="inline-block px-6 py-3 bg-primary-500 text-white rounded-lg hover:bg-primary-600 font-semibold">
                            Browse Webinars
                        </a>
                    </div>
                }
                else
                {
                    foreach (var booking in Model.Upcoming)
                    {
                        <div class="bg-white rounded-lg shadow border-l-4 @(booking.IsPaid ? "border-primary-500" : "border-amber-400") p-6">
                            <div class="flex flex-col md:flex-row gap-6">
                                <div class="flex-grow">
                                    <h3 class="text-2xl font-bold text-gray-900 mb-2">@booking.WebinarTitle</h3>
                                    <p class="text-sm text-gray-600 mb-4">
                                        Reference @booking.BookingReference
                                    </p>

                                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                                        <div>
                                            <p class="text-xs text-gray-600 font-semibold">Date &amp; Time</p>
                                            <p class="text-sm font-semibold text-gray-900">
                                                @booking.StartDateTime.ToSastDisplay()
                                            </p>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-600 font-semibold">Duration</p>
                                            <p class="text-sm font-semibold text-gray-900">
                                                @ViewHelpers.DurationLabel(booking.StartDateTime, booking.EndDateTime)
                                            </p>
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-600 font-semibold">Status</p>
                                            @if (booking.IsPaid)
                                            {
                                                <p class="text-sm font-semibold text-green-600">Confirmed ✓</p>
                                            }
                                            else
                                            {
                                                <p class="text-sm font-semibold text-amber-600">Awaiting payment</p>
                                            }
                                        </div>
                                        <div>
                                            <p class="text-xs text-gray-600 font-semibold">CPD Points</p>
                                            <p class="text-sm font-semibold text-gray-900">@booking.CpdPoints Points</p>
                                        </div>
                                    </div>

                                    <div class="flex gap-3 flex-wrap">
                                        @* The join link only exists once payment is confirmed —
                                           the API withholds it on unpaid bookings. *@
                                        @if (booking.IsPaid && !string.IsNullOrWhiteSpace(booking.JoinUrl))
                                        {
                                            <a href="@booking.JoinUrl" target="_blank" rel="noopener noreferrer"
                                               class="px-4 py-2 bg-primary-500 text-white rounded hover:bg-primary-600 font-semibold text-sm">
                                                Join Meeting
                                            </a>
                                        }

                                        <a asp-area="" asp-controller="Webinars" asp-action="Detail"
                                           asp-route-id="@booking.WebinarId"
                                           class="px-4 py-2 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 font-semibold text-sm">
                                            Get Details
                                        </a>

                                        <form asp-area="" asp-controller="Bookings" asp-action="Cancel" method="post"
                                              onsubmit="return confirm('Cancel this booking? This cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@booking.Id" />
                                            <button type="submit"
                                                    class="px-4 py-2 bg-red-50 text-red-700 rounded hover:bg-red-100 font-semibold text-sm">
                                                Cancel Booking
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="text-right flex-shrink-0">
                                    <p class="text-sm font-bold @(booking.IsPaid ? "text-green-600" : "text-amber-600")">
                                        @booking.Status
                                    </p>
                                    <p class="text-lg font-bold text-gray-900 mt-2">R@booking.Amount.ToString("N2")</p>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div x-show="activeTab === 'past'" class="space-y-4">

                @if (!Model.Past.Any())
                {
                    <div class="bg-white rounded-lg shadow p-12 text-center">
                        <p class="text-xl text-gray-700">
                            Your completed webinars will appear here.
                        </p>
                    </div>
                }
                else
                {
                    foreach (var booking in Model.Past)
                    {
                        <div class="bg-white rounded-lg shadow p-6 border-l-4 @(booking.AttendanceConfirmed ? "border-green-500" : "border-gray-300")">
                            <div class="flex flex-col md:flex-row gap-6">
                                <div class="flex-grow">
                                    <h3 class="text-xl font-bold text-gray-900 mb-1">@booking.WebinarTitle</h3>
                                    <p class="text-sm text-gray-600 mb-4">
                                        @booking.StartDateTime.ToSastDate() · Reference @booking.BookingReference
                                    </p>

                                    <div class="flex gap-3 flex-wrap">
                                        @if (booking.CanSubmitEvaluation)
                                        {
                                            <a asp-area="" asp-controller="Dashboard" asp-action="CreateEvaluations"
                                               asp-route-bookingId="@booking.Id"
                                               class="px-4 py-2 bg-blue-100 text-blue-700 rounded hover:bg-blue-200 font-semibold text-sm">
                                                Leave Feedback
                                            </a>
                                        }
                                        else if (booking.HasEvaluation)
                                        {
                                            <span class="px-4 py-2 bg-gray-100 text-gray-500 rounded font-semibold text-sm">
                                                Feedback submitted ✓
                                            </span>
                                        }

                                    </div>
                                </div>

                                <div class="text-right flex-shrink-0">
                                    @if (booking.AttendanceConfirmed)
                                    {
                                        <p class="text-sm font-bold text-green-600">Attended ✓</p>
                                        <p class="text-2xl font-bold text-yellow-500 mt-2">@booking.CpdPoints CPD</p>
                                    }
                                    else
                                    {
                                        <p class="text-sm font-bold text-gray-500">@booking.Status</p>
                                        <p class="text-xs text-gray-500 mt-2">Attendance not yet confirmed</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div x-show="activeTab === 'recordings'" class="space-y-4">
                
                <div class="bg-white rounded-lg shadow p-12 text-center">
                    <h3 class="text-xl font-bold text-gray-900 mb-3">Recordings</h3>
                    <p class="text-gray-700 max-w-xl mx-auto">
                        When a recording is ready, you'll be emailed a personal viewing link with
                        its expiry date. Links are tied to your account and cannot be shared.
                    </p>
                </div>
            </div>

            <div x-show="activeTab === 'cpd'" class="space-y-4">

                <div class="bg-white rounded-lg shadow p-6">
                    <div class="mb-6">
                        <h3 class="text-xl font-bold text-gray-900 mb-2">CPD Points Summary</h3>
                        <div class="flex items-baseline gap-3">
                            <p class="text-5xl font-bold text-primary-600">@Model.TotalCpdPoints</p>
                            <p class="text-gray-600">total points earned</p>
                        </div>
                    </div>

                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
                        <p class="text-sm text-blue-900">
                            <strong>Note:</strong> CPD points are credited once your attendance is
                            confirmed after each webinar, not at the point of booking.
                        </p>
                    </div>

                    @{
                        var cpdRows = Model.Past.Where(b => b.AttendanceConfirmed).ToList();
                    }

                    @if (!cpdRows.Any())
                    {
                        <p class="text-gray-600 py-6 text-center">
                            No CPD points yet. They'll appear here once attendance is confirmed for
                            a webinar you've completed.
                        </p>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm">
                                <thead class="bg-gray-100 border-b-2 border-gray-300">
                                    <tr>
                                        <th class="px-4 py-2 font-semibold text-gray-900">Webinar Title</th>
                                        <th class="px-4 py-2 font-semibold text-gray-900">Date Attended</th>
                                        <th class="px-4 py-2 font-semibold text-gray-900 text-right">CPD Points</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in cpdRows)
                                    {
                                        <tr class="border-b border-gray-200 hover:bg-gray-50">
                                            <td class="px-4 py-3">@row.WebinarTitle</td>
                                            <td class="px-4 py-3">@row.StartDateTime.ToSastDate()</td>
                                            <td class="px-4 py-3 text-right font-bold">@row.CpdPoints</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-gray-50 border-t-2 border-gray-300">
                                    <tr>
                                        <td class="px-4 py-3 font-bold" colspan="2">Total</td>
                                        <td class="px-4 py-3 text-right font-bold">@Model.TotalCpdPoints</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
