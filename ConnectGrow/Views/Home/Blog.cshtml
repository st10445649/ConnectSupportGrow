@{
    ViewBag.Title = "Blog";
}

<section class="gradient-primary py-12 md:py-16">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900">Blog</h1>
        <p class="text-lg text-gray-700 mt-4">Insights and tips for educators and therapists</p>
    </div>
</section>

<section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4 max-w-4xl">
        
        <!-- Search & Filter -->
        <div class="mb-12 flex gap-4">
            <input type="text" placeholder="Search posts..."
                class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
            <select class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                <option>All Categories</option>
                <option>Autism</option>
                <option>Speech & Language</option>
                <option>Inclusive Education</option>
                <option>Neurodiversity</option>
            </select>
        </div>
        
        <!-- Blog Posts Grid -->
        <div class="space-y-8 mb-12">
            
            <!-- Post 1 -->
            <article class="bg-white rounded-lg shadow hover:shadow-lg transition-smooth overflow-hidden md:flex">
                <div class="md:w-1/3 h-48 md:h-auto bg-gradient-primary flex items-center justify-center text-5xl">
                   <img src="~/images/webinars/autismpuzzle.jpeg" 
                         alt="Autism Spectrum Awareness Banner" 
                        class="w-full h-48 sm:h-64 md:h-80 lg:h-96 object-cover" />
                </div>
                <div class="p-6 md:w-2/3">
                    <div class="flex gap-2 mb-3">
                        <span class="px-2 py-1 bg-primary-100 text-white rounded text-xs font-semibold">Autism</span>
                        <span class="text-xs text-gray-600">June 20, 2026</span>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-2 hover:text-primary-600">
                        <a href="/home/blogdetail">Creating Sensory-Friendly Classrooms for Autistic Learners</a>
                    </h3>
                    <p class="text-gray-700 mb-4 line-clamp-2">
                        Understand how sensory sensitivities affect autistic students and learn practical strategies for 
                        creating inclusive, sensory-friendly learning environments. From lighting to sound management, 
                        discover evidence-based modifications you can implement immediately.
                    </p>
                    <a href="/home/blogdetail" class="text-primary-600 hover:text-primary-700 font-semibold">
                        Read More →
                    </a>
                </div>
            </article>
            
            <!-- Post 2 -->
            <article class="bg-white rounded-lg shadow hover:shadow-lg transition-smooth overflow-hidden md:flex">
                <div class="md:w-1/3 h-48 md:h-auto bg-gradient-accent flex items-center justify-center text-5xl">
                      <img src="~/images/webinars/speechdelays.png" 
                         alt="Autism Spectrum Awareness Banner" 
                        class="w-full h-48 sm:h-64 md:h-80 lg:h-96 object-cover" />
                </div>
                <div class="p-6 md:w-2/3">
                    <div class="flex gap-2 mb-3">
                        <span class="px-2 py-1 bg-secondary-100 text-white rounded text-xs font-semibold">Speech & Language</span>
                        <span class="text-xs text-gray-600">June 10, 2026</span>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-2 hover:text-primary-600">
                        <a href="/home/blogdetail">Early Intervention for Speech Delays: What Teachers Need to Know</a>
                    </h3>
                    <p class="text-gray-700 mb-4 line-clamp-2">
                        Speech delays in early childhood can impact academic success and social development. Learn to identify 
                        red flags and discover classroom strategies that support speech and language development for all learners.
                    </p>
                    <a href="/home/blogdetail" class="text-primary-600 hover:text-primary-700 font-semibold">
                        Read More →
                    </a>
                </div>
            </article>
            
            <!-- Post 3 -->
            <article class="bg-white rounded-lg shadow hover:shadow-lg transition-smooth overflow-hidden md:flex">
                <div class="md:w-1/3 h-48 md:h-auto bg-primary-200 flex items-center justify-center text-5xl">
                     <img src="~/images/webinars/autism3.jpeg" 
                         alt="Autism Spectrum Awareness Banner" 
                        class="w-full h-48 sm:h-64 md:h-80 lg:h-96 object-cover" />
                </div>
                <div class="p-6 md:w-2/3">
                    <div class="flex gap-2 mb-3">
                        <span class="px-2 py-1 bg-green-100 text-green-700 rounded text-xs font-semibold">Inclusive Education</span>
                        <span class="text-xs text-gray-600">May 30, 2026</span>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-2 hover:text-primary-600">
                        <a href="/home/blogdetail">Neurodiversity-Affirming Practices: Beyond Compliance</a>
                    </h3>
                    <p class="text-gray-700 mb-4 line-clamp-2">
                        Moving beyond compliance-based approaches, explore how to create truly inclusive classrooms that celebrate 
                        neurodiversity and honor the strengths of all learners, including those with autism, dyslexia, and ADHD.
                    </p>
                    <a href="/home/blogdetail" class="text-primary-600 hover:text-primary-700 font-semibold">
                        Read More →
                    </a>
                </div>
            </article>
        </div>
        
        <!-- Pagination -->
        <div class="flex justify-center gap-2">
            <button class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-100 disabled:opacity-50" disabled>← Previous</button>
            <button class="px-4 py-2 bg-primary-500 text-white rounded font-semibold">1</button>
            <button class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-100">2</button>
            <button class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-100">Next →</button>
        </div>
    </div>
</section>
