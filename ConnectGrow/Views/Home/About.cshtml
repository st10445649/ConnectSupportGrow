@{
    ViewBag.Title = "About Us";
}

<section class="gradient-primary py-12 md:py-16">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900">About Connect Grow Support</h1>
        <p class="text-lg text-gray-700 mt-4">Dedicated to professional development in education</p>
    </div>
</section>

<section class="py-16">
    <div class="container mx-auto px-4 max-w-4xl">
        
        <!-- Mission -->
        <div class="mb-16">
            <h2 class="text-3xl font-bold text-gray-900 mb-4">Our Mission</h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-4">
                We exist to empower educators and speech-language pathologists with evidence-based, practical training 
                that directly improves outcomes for neurodivergent learners. Through accessible, affordable professional 
                development, we help professionals grow, so they can better serve their students and clients.
            </p>
        </div>
        
        <!-- Founder Bio -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
            <div class="md:col-span-1">
                <div class="w-full aspect-square bg-secondary-200 rounded-lg flex items-center justify-center text-7xl">
                    👩‍🏫
                </div>
            </div>
            <div class="md:col-span-2">
                <h3 class="text-2xl font-bold text-gray-900 mb-2">Meet the Founder</h3>
                <p class="text-gray-700 mb-4 leading-relaxed">
                    Connect Grow Support was founded by a passionate speech-language pathologist with over 15 years 
                    of experience in school and clinical settings. Frustrated with the lack of accessible CPD opportunities, 
                    she created this platform to change the landscape of professional development in South Africa.
                </p>
                <p class="text-gray-700 leading-relaxed">
                    With hands-on classroom experience and ongoing clinical work, every webinar brings both theoretical 
                    expertise and practical wisdom.
                </p>
            </div>
        </div>
        
        <!-- Values -->
        <div class="mb-16">
            <h3 class="text-3xl font-bold text-gray-900 mb-8">Our Core Values</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white rounded-lg border-l-4 border-primary-500 p-6">
                    <p class="text-3xl mb-3">🎓</p>
                    <p class="font-bold text-gray-900 mb-2">Evidence-Based</p>
                    <p class="text-gray-700 text-sm">All training is grounded in current research and best practices</p>
                </div>
                <div class="bg-white rounded-lg border-l-4 border-secondary-500 p-6">
                    <p class="text-3xl mb-3">♿</p>
                    <p class="font-bold text-gray-900 mb-2">Inclusive</p>
                    <p class="text-gray-700 text-sm">Neurodiversity is a strength, not a deficit</p>
                </div>
                <div class="bg-white rounded-lg border-l-4 border-accent-500 p-6">
                    <p class="text-3xl mb-3">🌍</p>
                    <p class="font-bold text-gray-900 mb-2">Accessible</p>
                    <p class="text-gray-700 text-sm">Professional development should be affordable and convenient</p>
                </div>
            </div>
        </div>
        
        <!-- Impact -->
        <div class="bg-gradient-accent rounded-lg p-8 mb-16 text-center">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">Our Impact</h3>
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <p class="text-4xl font-bold text-primary-600">500+</p>
                    <p class="text-sm text-gray-700 mt-2">Professionals trained</p>
                </div>
                <div>
                    <p class="text-4xl font-bold text-secondary-600">50+</p>
                    <p class="text-sm text-gray-700 mt-2">Webinars delivered</p>
                </div>
                <div>
                    <p class="text-4xl font-bold text-accent-600">1000+</p>
                    <p class="text-sm text-gray-700 mt-2">CPD points awarded</p>
                </div>
            </div>
        </div>
        
        <!-- Contact -->
        <div class="text-center py-8 border-t border-gray-200">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Want to Connect?</h3>
            <p class="text-gray-700 mb-6">Have questions, feedback, or partnership ideas?</p>
            <a href="mailto:support@connectgrowsupport.com" class="inline-block px-8 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-bold">
                Get in Touch
            </a>
        </div>
    </div>
</section>
