@{
    ViewBag.Title = "About Us";
}

<section class="gradient-primary py-12 md:py-16">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900">About Connect Grow Support</h1>
        <p class="text-lg text-gray-700 mt-4">Dedicated to professional development in education</p>
    </div>
</section>




<section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-16">
            
            <div>
                <img src="~/images/webinars/dyslexia.jpg" 
                     alt="Our Mission" 
                     class="w-full h-56 sm:h-64 md:h-80 object-cover rounded-lg shadow-lg" />
            </div>

            <div>
                <h2 class="text-2xl md:text-4xl font-bold text-gray-900 mb-4">
                    Our Mission
                </h2>
                <p class="text-gray-700 mb-4 text-base md:text-lg leading-relaxed">
                    Connect Grow Support exists to empower South African educators with the knowledge 
                    and skills to support neurodivergent learners. We believe every child deserves an 
                    inclusive, supportive learning environment.
                </p>
                <p class="text-gray-700 text-base md:text-lg leading-relaxed">
                    Through expert-led webinars, practical strategies, and professional community, 
                    we're transforming how South African schools support neurodivergent learners.
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div class="order-2 md:order-1">
                <h2 class="text-2xl md:text-4xl font-bold text-gray-900 mb-4">
                    Our Vision
                </h2>
                <p class="text-gray-700 mb-4 text-base md:text-lg leading-relaxed">
                    We envision a South Africa where every educator is equipped with the knowledge, 
                    confidence, and resources to create inclusive classrooms.
                </p>
                <p class="text-gray-700 text-base md:text-lg leading-relaxed">
                    Where neurodivergent learners don't just survive, but thrive. Where their strengths 
                    are celebrated and their unique ways of learning are valued.
                </p>
            </div>
            <div class="order-1 md:order-2">
                <img src="~/images/webinars/webinarautism.jpg" 
                     alt="Our Vision" 
                     class="w-full h-56 sm:h-64 md:h-80 object-cover rounded-lg shadow-lg" />
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-2xl md:text-4xl font-bold text-gray-900 mb-12 text-center">
            Meet Our Team
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
            
            <div class="bg-white rounded-lg overflow-hidden shadow-md text-center">
                <img src="~/images/blueicon.png" 
                     alt="Team Member" 
                     class="w-full h-48 sm:h-56 md:h-64 object-cover" />
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Sarah Mitchell</h3>
                    <p class="text-purple-600 font-semibold mb-3">Founder & Lead Educator</p>
                    <p class="text-gray-700 text-sm">
                        Speech therapist with 15+ years experience in South African schools.
                    </p>
                </div>
            </div>
            
            <div class="bg-white rounded-lg overflow-hidden shadow-md text-center">
                <img src="~/images/pinkicon.png" 
                     alt="Team Member" 
                     class="w-full h-48 sm:h-56 md:h-64 object-cover" />
                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-2">John Doe</h3>
                    <p class="text-purple-600 font-semibold mb-3">Educational Psychologist</p>
                    <p class="text-gray-700 text-sm">
                        Specialist in neurodiversity and inclusive education practices.
                    </p>
                </div>
            </div>
            
        </div>
    </div>
</section>

<section class="py-12 md:py-16 gradient-header">
    <div class="max-w-4xl mx-auto text-center px-4">
        <h2 class="text-2xl md:text-4xl font-bold text-white mb-4">
            Join Our Movement
        </h2>
        <p class="text-white mb-8 text-base md:text-lg">
            Be part of the transformation happening in South African education.
        </p>
        <a href="/webinars" class="inline-block px-8 py-4 bg-primary-500 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-lg">
            Explore Webinars Now
        </a>
    </div>
</section>