@{
    ViewBag.Title = "Frequently Asked Questions";
}

<section class="gradient-primary py-12 md:py-16">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900">Frequently Asked Questions</h1>
        <p class="text-lg text-gray-700 mt-4">Find answers to common questions</p>
    </div>
</section>

<section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4 max-w-3xl">
        
        <div class="space-y-4 mb-12">
            
            <!-- FAQ 1 -->
            <div x-data="{ open: false }" class="bg-white rounded-lg border border-gray-200 p-6 hover:border-primary-300 transition-smooth">
                <button x-on:click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                    <span>How do I enroll in a webinar?</span>
                    <span x-text="open ? '▼' : '▶'" class="transition-transform"></span>
                </button>
                <p x-show="open" class="mt-4 text-gray-700 leading-relaxed">
                    Browse our webinar catalogue, select one that interests you, and click "Book Now". You'll be taken 
                    to a secure checkout page. After payment confirmation, you'll receive a Zoom link via email 24 hours before the event.
                </p>
            </div>
            
            <!-- FAQ 2 -->
            <div x-data="{ open: false }" class="bg-white rounded-lg border border-gray-200 p-6 hover:border-primary-300 transition-smooth">
                <button x-on:click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                    <span>What are CPD points and how do I earn them?</span>
                    <span x-text="open ? '▼' : '▶'" class="transition-transform"></span>
                </button>
                <p x-show="open" class="mt-4 text-gray-700 leading-relaxed">
                    CPD (Continuing Professional Development) points are professional credits recognized by SASLHA and HPCSA. 
                    Each webinar awards points based on duration and content. After attending, you can download your certificate 
                    from your dashboard.
                </p>
            </div>
            
            <!-- FAQ 3 -->
            <div x-data="{ open: false }" class="bg-white rounded-lg border border-gray-200 p-6 hover:border-primary-300 transition-smooth">
                <button x-on:click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                    <span>Can I watch a recording if I miss the live session?</span>
                    <span x-text="open ? '▼' : '▶'" class="transition-transform"></span>
                </button>
                <p x-show="open" class="mt-4 text-gray-700 leading-relaxed">
                    Yes! All webinars are recorded and available to registered attendees for 30 days after the event. 
                    You'll receive the recording link via email within 24 hours of the session.
                </p>
            </div>
            
            <!-- FAQ 4 -->
            <div x-data="{ open: false }" class="bg-white rounded-lg border border-gray-200 p-6 hover:border-primary-300 transition-smooth">
                <button x-on:click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                    <span>What payment methods do you accept?</span>
                    <span x-text="open ? '▼' : '▶'" class="transition-transform"></span>
                </button>
                <p x-show="open" class="mt-4 text-gray-700 leading-relaxed">
                    We accept all major payment methods through PayFast, South Africa's leading payment processor. 
                    You can pay with credit card, debit card, or bank transfer. Your payment information is secure and encrypted.
                </p>
            </div>
            
            <!-- FAQ 5 -->
            <div x-data="{ open: false }" class="bg-white rounded-lg border border-gray-200 p-6 hover:border-primary-300 transition-smooth">
                <button x-on:click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                    <span>What's your refund policy?</span>
                    <span x-text="open ? '▼' : '▶'" class="transition-transform"></span>
                </button>
                <p x-show="open" class="mt-4 text-gray-700 leading-relaxed">
                    We offer a 7-day refund guarantee. If you're not satisfied with a webinar, request a refund within 
                    7 days of purchase for a full refund. No questions asked.
                </p>
            </div>
            
            <!-- FAQ 6 -->
            <div x-data="{ open: false }" class="bg-white rounded-lg border border-gray-200 p-6 hover:border-primary-300 transition-smooth">
                <button click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                    <span>Are webinars suitable for both educators and therapists?</span>
                    <span x-text="open ? '▼' : '▶'" class="transition-transform"></span>
                </button>
                <p x-show="open" class="mt-4 text-gray-700 leading-relaxed">
                    Yes! Many of our webinars apply to both fields. Look for the category label on each webinar 
                    (Educators, Parents, General, etc.) to find ones matching your role.
                </p>
            </div>
            
            <!-- FAQ 7 -->
            <div x-data="{ open: false }" class="bg-white rounded-lg border border-gray-200 p-6 hover:border-primary-300 transition-smooth">
                <button x-on:click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                    <span>Do I need any special software to join a webinar?</span>
                    <span x-text="open ? '▼' : '▶'" class="transition-transform"></span>
                </button>
                <p x-show="open" class="mt-4 text-gray-700 leading-relaxed">
                    No! Webinars are hosted on Zoom, which works in your web browser. You don't need to download anything. 
                    Just click the link from your email and join. A phone or computer with internet is all you need.
                </p>
            </div>
            
            <!-- FAQ 8 -->
            <div x-data="{ open: false }" class="bg-white rounded-lg border border-gray-200 p-6 hover:border-primary-300 transition-smooth">
                <button x-on:click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                    <span>Can I download the webinar materials?</span>
                    <span x-text="open ? '▼' : '▶'" class="transition-transform"></span>
                </button>
                <p x-show="open" class="mt-4 text-gray-700 leading-relaxed">
                    Absolutely! Presenter slides, resource lists, and supplementary materials are provided as downloadable 
                    PDFs after each webinar.
                </p>
            </div>
        </div>
        
        <!-- Support CTA -->
        <div class="bg-primary-50 border border-primary-200 rounded-lg p-8 text-center">
            <h3 class="text-xl font-bold text-gray-900 mb-2">Didn't find your answer?</h3>
            <p class="text-gray-700 mb-4">Contact our support team</p>
            <a href="mailto:support@connectgrowsupport.com" class="inline-block px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-semibold">
                Email Support
            </a>
        </div>
    </div>
</section>