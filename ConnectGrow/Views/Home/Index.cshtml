@{
    ViewBag.Title = "Home";
}


<section class="gradient-primary py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            
            @* Left: Text *@
            <div>
                <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 leading-tight">
                    Professional Development for Speech-Language Pathologists
                </h1>
                <p class="text-lg text-gray-700 mb-6 leading-relaxed">
                    Access expert-led webinars, earn CPD points, and grow your skills with Connect Grow Support. 
                    Trusted by educators and therapists across South Africa.
                </p>
                <div class="flex gap-4 flex-wrap">
                    <a href="/webinars" class="px-6 py-3 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-smooth font-semibold">
                        Browse Webinars
                    </a>
                    <a href="#featured" class="px-6 py-3 bg-white text-primary-600 border-2 border-primary-500 rounded-lg hover:bg-primary-50 transition-smooth font-semibold">
                        Learn More
                    </a>
                </div>
            </div>
            
            @* Right: Illustration/Image *@
            <div class="bg-gradient-accent rounded-lg p-8 text-center">
                <div class="text-6xl mb-4">👥</div>
                <p class="text-gray-700 font-medium">Join 500+ professionals</p>
                <p class="text-sm text-gray-600">Learning together, growing together</p>
            </div>
        </div>
    </div>
</section>

<section class="bg-white py-12 md:py-16 border-b border-gray-200">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            @* Stat 1: Webinars *@
            <div class="text-center p-6">
                <div class="text-4xl font-bold text-primary-600 mb-2">50+</div>
                <p class="text-gray-700 font-medium mb-1">Webinars Delivered</p>
                <p class="text-sm text-gray-600">Expert-led training sessions</p>
            </div>
            
            @* Stat 2: Users *@
            <div class="text-center p-6">
                <div class="text-4xl font-bold text-secondary-600 mb-2">500+</div>
                <p class="text-gray-700 font-medium mb-1">Professionals Trained</p>
                <p class="text-sm text-gray-600">From across South Africa</p>
            </div>
            
            @* Stat 3: CPD Points *@
            <div class="text-center p-6">
                <div class="text-4xl font-bold text-accent-600 mb-2">1000+</div>
                <p class="text-gray-700 font-medium mb-1">CPD Points Awarded</p>
                <p class="text-sm text-gray-600">Professional development credits</p>
            </div>
        </div>
    </div>
</section>


<section id="featured" class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Featured Webinars</h2>
            <p class="text-lg text-gray-700">Upcoming sessions you won't want to miss</p>
        </div>
        
        @* Webinar Grid *@
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
            
            @* Sample Webinar 1 *@
            <div class="bg-white rounded-lg shadow hover:shadow-lg transition-smooth overflow-hidden border border-gray-100">
                <div class="h-48 bg-gradient-primary flex items-center justify-center text-6xl">
                    🧠
                </div>
                <div class="p-6">
                    <div class="inline-block px-3 py-1 bg-primary-100 text-primary-700 rounded-full text-xs font-semibold mb-3">
                        Educators
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Autism Spectrum Awareness</h3>
                    <p class="text-sm text-gray-600 mb-4">Understanding autism in educational settings</p>
                    
                    <div class="space-y-2 text-sm text-gray-700 mb-4">
                        <p>📅 July 15, 2026 · 2:00 PM</p>
                        <p>💰 R150</p>
                        <p>🎓 5 CPD Points</p>
                    </div>
                    
                    <a href="/webinars/1" class="w-full py-2 bg-primary-500 text-white rounded hover:bg-primary-600 transition-smooth font-semibold text-center block">
                        Learn More
                    </a>
                </div>
            </div>
            
            @* Sample Webinar 2 *@
            <div class="bg-white rounded-lg shadow hover:shadow-lg transition-smooth overflow-hidden border border-gray-100">
                <div class="h-48 bg-gradient-accent flex items-center justify-center text-6xl">
                    📚
                </div>
                <div class="p-6">
                    <div class="inline-block px-3 py-1 bg-secondary-100 text-secondary-700 rounded-full text-xs font-semibold mb-3">
                        Educators
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Dyslexia in the Classroom</h3>
                    <p class="text-sm text-gray-600 mb-4">Practical strategies for supporting dyslexic learners</p>
                    
                    <div class="space-y-2 text-sm text-gray-700 mb-4">
                        <p>📅 July 22, 2026 · 3:30 PM</p>
                        <p>💰 R150</p>
                        <p>🎓 5 CPD Points</p>
                    </div>
                    
                    <a href="/webinars/2" class="w-full py-2 bg-secondary-500 text-white rounded hover:bg-secondary-600 transition-smooth font-semibold text-center block">
                        Learn More
                    </a>
                </div>
            </div>
            
            @* Sample Webinar 3 *@
            <div class="bg-white rounded-lg shadow hover:shadow-lg transition-smooth overflow-hidden border border-gray-100">
                <div class="h-48 bg-gradient-primary flex items-center justify-center text-6xl">
                    🗣️
                </div>
                <div class="p-6">
                    <div class="inline-block px-3 py-1 bg-accent-100 text-accent-700 rounded-full text-xs font-semibold mb-3">
                        Parents
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">Speech Delay: Parent Guide</h3>
                    <p class="text-sm text-gray-600 mb-4">How to support your child's speech development</p>
                    
                    <div class="space-y-2 text-sm text-gray-700 mb-4">
                        <p>📅 July 29, 2026 · 1:00 PM</p>
                        <p>💰 R100</p>
                        <p>🎓 3 CPD Points</p>
                    </div>
                    
                    <a href="/webinars/3" class="w-full py-2 bg-accent-500 text-white rounded hover:bg-accent-600 transition-smooth font-semibold text-center block">
                        Learn More
                    </a>
                </div>
            </div>
        </div>
        
        @* CTA: View All *@
        <div class="text-center">
            <a href="/webinars" class="inline-block px-8 py-3 border-2 border-primary-500 text-primary-600 rounded-lg hover:bg-primary-50 transition-smooth font-semibold">
                View All Webinars →
            </a>
        </div>
    </div>
</section>

@* ════════════════════════════════════════════════════════════════════════ *@
@* ABOUT SECTION (PREVIEW)                                                  *@
@* ════════════════════════════════════════════════════════════════════════ *@

<section class="bg-gray-50 py-16 md:py-24 border-b border-gray-200">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            
            @* Left: Image/Icon *@
            <div class="bg-gradient-accent rounded-lg p-8 text-center">
                <div class="text-8xl mb-4">🌱</div>
                <p class="text-gray-700 font-medium">Supporting growth in education</p>
            </div>
            
            @* Right: Text *@
            <div>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">About Connect Grow Support</h2>
                <p class="text-gray-700 text-lg mb-4 leading-relaxed">
                    We're a dedicated team of speech-language pathologists and educators passionate about 
                    professional development. With over 10 years of experience, we provide high-quality, 
                    evidence-based training to educators and therapists across South Africa.
                </p>
                <p class="text-gray-700 text-lg mb-6 leading-relaxed">
                    Our mission is simple: help professionals grow, so they can better support their students and clients.
                </p>
                <a href="/about" class="inline-block px-6 py-3 bg-primary-500 text-white rounded-lg hover:bg-primary-600 transition-smooth font-semibold">
                    Read Our Full Story
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-16 md:py-24">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-900 mb-12">What Professionals Are Saying</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            
            @* Testimonial 1 *@
            <div class="bg-white rounded-lg p-6 shadow border-l-4 border-primary-500">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 bg-primary-200 rounded-full"></div>
                    <div>
                        <p class="font-semibold text-gray-900">Sarah Johnson</p>
                        <p class="text-sm text-gray-600">Special Needs Educator</p>
                    </div>
                </div>
                <p class="text-gray-700 italic">
                    "The webinars are incredibly practical and evidence-based. I've applied the strategies 
                    in my classroom and seen real results with my students."
                </p>
            </div>
            
            @* Testimonial 2 *@
            <div class="bg-white rounded-lg p-6 shadow border-l-4 border-secondary-500">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 bg-secondary-200 rounded-full"></div>
                    <div>
                        <p class="font-semibold text-gray-900">Michael Chen</p>
                        <p class="text-sm text-gray-600">Speech Therapist</p>
                    </div>
                </div>
                <p class="text-gray-700 italic">
                    "Easy access to CPD points and high-quality content. Highly recommend for anyone 
                    looking to stay current in their field."
                </p>
            </div>
        </div>
    </div>
</section>

@* ════════════════════════════════════════════════════════════════════════ *@
@* CTA SECTION                                                              *@
@* ════════════════════════════════════════════════════════════════════════ *@

<section class="gradient-primary py-16 md:py-20">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Ready to Grow Your Skills?</h2>
        <p class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto">
            Join hundreds of professionals who are advancing their careers with our expert-led webinars.
        </p>
        <a href="/webinars" class="inline-block px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-lg">
            Explore Webinars Now
        </a>
    </div>
</section>
