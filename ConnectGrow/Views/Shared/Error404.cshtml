@{
    ViewBag.Title = "Page Not Found";
}

<section class="min-h-screen flex items-center justify-center bg-gradient-primary px-4 py-12">
    <div class="text-center max-w-md">
        
        <div class="text-8xl font-bold text-primary-600 mb-4">404</div>
        
        <h1 class="text-4xl font-bold text-gray-900 mb-3">Oops! Page Not Found</h1>
        
        <p class="text-lg text-gray-700 mb-8">
            The page you're looking for doesn't exist or has been moved.
        </p>
        
        <div class="space-y-3">
            <a href="/" class="block py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-bold transition-smooth">
                Go Home
            </a>
            <a href="/webinars" class="block py-3 border-2 border-primary-500 text-primary-600 rounded-lg hover:bg-primary-50 font-bold transition-smooth">
                Browse Webinars
            </a>
        </div>
        
        <p class="text-sm text-gray-600 mt-8">
            Need help? <a href="mailto:support@connectgrowsupport.com" class="text-primary-600 hover:underline font-semibold">Contact support</a>
        </p>
    </div>
</section>