@{
    ViewBag.Title = "Server Error";
}

<section class="min-h-screen flex items-center justify-center bg-gradient-primary px-4 py-12">
    <div class="text-center max-w-md">
        
        <div class="text-8xl mb-4">⚠️</div>
        
        <h1 class="text-4xl font-bold text-gray-900 mb-3">Something went wrong</h1>
        
        <p class="text-lg text-gray-700 mb-8">
            We're experiencing a technical issue. Our team has been notified and is working on a fix.
            Please try again in a few moments.
        </p>
        
        <div class="space-y-3">
            <button onclick="location.reload()" class="w-full py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-bold transition-smooth">
                Refresh Page
            </button>
            <a href="/" class="block py-3 border-2 border-primary-500 text-primary-600 rounded-lg hover:bg-primary-50 font-bold transition-smooth">
                Go Home
            </a>
        </div>
        
        <p class="text-sm text-gray-600 mt-8">
            Error ID: <span class="font-mono">500-@DateTime.Now:yyyyMMddHHmmss</span><br>
            <a href="mailto:support@connectgrowsupport.com" class="text-primary-600 hover:underline font-semibold">Report this issue</a>
        </p>
    </div>
</section>