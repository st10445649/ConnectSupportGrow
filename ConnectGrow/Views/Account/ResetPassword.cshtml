
@{
    ViewBag.Title = "Reset Password";
}

<section class="min-h-screen flex items-center justify-center bg-gradient-primary py-12 px-4">
    <div class="max-w-md w-full">
        
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Create New Password</h1>
            <p class="text-gray-700">Enter your new password below</p>
        </div>
        
        <div class="bg-white rounded-lg shadow-xl p-8 space-y-6">
            
            <!-- New Password -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">New Password</label>
                <input type="password" name="password" required placeholder="••••••••"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
                <p class="text-xs text-gray-600 mt-1">Min 8 characters, 1 uppercase, 1 number</p>
            </div>
            
            <!-- Confirm Password -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">Confirm Password</label>
                <input type="password" name="confirmPassword" required placeholder="••••••••"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
            </div>
            
            <button type="submit" class="w-full py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-lg">
                Reset Password
            </button>
        </div>
        
        <p class="text-center text-gray-700 mt-6">
            Remember your password? 
            <a href="/account/login" class="text-primary-600 hover:text-primary-700 font-bold">Sign in here</a>
        </p>
    </div>
</section>
