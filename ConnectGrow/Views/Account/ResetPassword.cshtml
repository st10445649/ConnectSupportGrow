@model ConnectGrow.Models.ResetPasswordInputModel
@{
    ViewBag.Title = "Create New Password";
}

<section class="min-h-screen flex items-center justify-center bg-gradient-primary py-12 px-4">
    <div class="max-w-md w-full">

        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Create New Password</h1>
            <p class="text-gray-700">Enter your new password below</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="bg-white rounded-lg shadow-xl p-8 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" role="alert"
                 class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded text-sm empty:hidden"></div>

            <div>
                <label asp-for="NewPassword" class="block text-sm font-semibold text-gray-900 mb-2">New Password</label>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="••••••••"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
                <p class="text-xs text-gray-600 mt-1">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</p>
                <span asp-validation-for="NewPassword" class="text-sm text-red-700"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-gray-900 mb-2">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
                <span asp-validation-for="ConfirmPassword" class="text-sm text-red-700"></span>
            </div>

            <button type="submit" class="w-full py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-lg">
                Reset Password
            </button>
        </form>

        <p class="text-center text-gray-700 mt-6">
            Remember your password?
            <a asp-action="Login" class="text-primary-600 hover:text-primary-700 font-bold">Sign in here</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
