@model ConnectGrow.Models.LoginInputModel
@{
    ViewBag.Title = "Sign In";
}

<section class="min-h-screen flex items-center justify-center bg-gradient-primary py-12 px-4">
    <div class="max-w-md w-full">

        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Welcome Back</h1>
            <p class="text-gray-700">Sign in to your Connect Grow Support account</p>
        </div>

        <form asp-action="Login" method="post" class="bg-white rounded-lg shadow-xl p-8 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            @if (TempData["Message"] is string flash)
            {
                <div role="status" class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded">
                    <p class="text-sm font-semibold">@flash</p>
                </div>
            }
            <div asp-validation-summary="All" role="alert"
                 class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 rounded text-sm empty:hidden"></div>

            <div>
                <label asp-for="Email" class="block text-sm font-semibold text-gray-900 mb-2">Email Address</label>
                <input asp-for="Email" type="email" autocomplete="username" placeholder="you@example.com"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
            </div>

            <div>
                <div class="flex items-center justify-between mb-2">
                    <label asp-for="Password" class="block text-sm font-semibold text-gray-900">Password</label>
                    <a asp-action="ForgotPassword" class="text-xs text-primary-600 hover:text-primary-700 font-semibold">Forgot?</a>
                </div>
                <input asp-for="Password" type="password" autocomplete="current-password" placeholder="••••••••"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
            </div>

            <button type="submit" class="w-full py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-lg">
                Sign In
            </button>
        </form>

        <p class="text-center text-gray-700 mt-6">
            Don't have an account?
            <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl"
               class="text-primary-600 hover:text-primary-700 font-bold">Create one here</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
