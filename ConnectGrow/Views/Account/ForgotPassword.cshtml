@model ConnectGrow.Models.ForgotPasswordInputModel
@{
    ViewBag.Title = "Reset Password";
}

<section class="min-h-screen flex items-center justify-center bg-gradient-primary py-12 px-4">
    <div class="max-w-md w-full">

        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Reset Password</h1>
            <p class="text-gray-700">Enter your email to receive a password reset link</p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="bg-white rounded-lg shadow-xl p-8 space-y-6">
            @Html.AntiForgeryToken()

            <div>
                <label asp-for="Email" class="block text-sm font-semibold text-gray-900 mb-2">Email Address</label>
                <input asp-for="Email" type="email" autocomplete="username" placeholder="you@example.com"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
                <span asp-validation-for="Email" class="text-sm text-red-700"></span>
            </div>
            @if (ViewBag.SuccessMessage != null)
            {
                <div role="status" class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded">
                    <p class="text-sm font-semibold">✓ @ViewBag.SuccessMessage</p>
                    <p class="text-xs mt-1">The link expires shortly, so use it soon.</p>
                </div>
            }

            @* Development convenience only will be ammended after adding send grid *@
            @if (ViewBag.DevResetLink != null)
            {
                <div class="bg-amber-50 border border-amber-200 rounded p-4">
                    <p class="text-xs font-semibold text-amber-900 mb-2">
                        Development only — no email was sent:
                    </p>
                    <a href="@ViewBag.DevResetLink" class="text-xs text-amber-900 underline break-all">
                        @ViewBag.DevResetLink
                    </a>
                </div>
            }

            <button type="submit" class="w-full py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-lg">
                Send Reset Link
            </button>
        </form>

        <div class="mt-6 text-center">
            <a asp-action="Login" class="text-primary-600 hover:text-primary-700 font-semibold">Back to sign in</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
