@{
    ViewBag.Title = "Account Settings";
}

<section class="bg-white border-b border-gray-200 py-8">
    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold text-gray-900">Account Settings</h1>
        <p class="text-gray-700">Manage your profile and preferences</p>
    </div>
</section>

<section class="py-12 bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4 max-w-2xl">
        
        <div x-data="{ tab: 'profile' }" class="space-y-6">
            
            
            <div class="flex gap-2 bg-white rounded-lg p-2 shadow border border-gray-200">
                <button x-on:click="tab = 'profile'" 
                    :class="tab === 'profile' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 px-4 py-2 rounded font-semibold transition-smooth">
                    👤 Profile
                </button>
                <button x-on:click="tab = 'password'" 
                    :class="tab === 'password' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 px-4 py-2 rounded font-semibold transition-smooth">
                    🔐 Password
                </button>
                <button x-on:click="tab = 'preferences'" 
                    :class="tab === 'preferences' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 px-4 py-2 rounded font-semibold transition-smooth">
                    ⚙️ Preferences
                </button>
                <button x-on:click="tab = 'security'" 
                    :class="tab === 'security' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 px-4 py-2 rounded font-semibold transition-smooth">
                    🔒 Security
                </button>
            </div>
            

            <div x-show="tab === 'profile'" class="bg-white rounded-lg shadow p-6 space-y-6">
                <h2 class="text-2xl font-bold text-gray-900">Profile Information</h2>
                
                <form class="space-y-4">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-900 mb-2">First Name</label>
                            <input type="text" name="firstName" value="Sarah"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-900 mb-2">Last Name</label>
                            <input type="text" name="lastName" value="Johnson"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-900 mb-2">Email Address</label>
                        <input type="email" name="email" value="sarah@example.com"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <p class="text-xs text-gray-600 mt-1">✓ Verified</p>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-900 mb-2">Phone Number (Optional)</label>
                        <input type="tel" name="phone" placeholder="+27 (0)XX XXX XXXX"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                    </div>
                    
                    <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-semibold">
                        Save Changes
                    </button>
                </form>
            </div>
            

            <div x-show="tab === 'password'" class="bg-white rounded-lg shadow p-6 space-y-6">
                <h2 class="text-2xl font-bold text-gray-900">Change Password</h2>
                
                <form class="space-y-4 max-w-md">
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-900 mb-2">Current Password</label>
                        <input type="password" name="currentPassword" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-900 mb-2">New Password</label>
                        <input type="password" name="newPassword" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <p class="text-xs text-gray-600 mt-1">Min 8 characters, 1 uppercase, 1 number</p>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-900 mb-2">Confirm New Password</label>
                        <input type="password" name="confirmPassword" required
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                    </div>
                    
                    <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-semibold">
                        Update Password
                    </button>
                </form>
            </div>
            

            <div x-show="tab === 'preferences'" class="bg-white rounded-lg shadow p-6 space-y-6">
                <h2 class="text-2xl font-bold text-gray-900">Preferences</h2>
                
                <div class="space-y-4">
                    
                    <div class="border border-gray-200 rounded p-4">
                        <label class="flex items-center">
                            <input type="checkbox" checked class="w-4 h-4 text-primary-500 rounded">
                            <span class="ml-3 text-gray-900 font-semibold">Email me about new webinars</span>
                        </label>
                        <p class="text-sm text-gray-600 ml-7 mt-1">Get notified when new webinars matching your interests are scheduled</p>
                    </div>
                    
                    <div class="border border-gray-200 rounded p-4">
                        <label class="flex items-center">
                            <input type="checkbox" checked class="w-4 h-4 text-primary-500 rounded">
                            <span class="ml-3 text-gray-900 font-semibold">Email me about CPD reminders</span>
                        </label>
                        <p class="text-sm text-gray-600 ml-7 mt-1">Get reminded about upcoming webinars you've booked</p>
                    </div>
                    
                    <div class="border border-gray-200 rounded p-4">
                        <label class="flex items-center">
                            <input type="checkbox" class="w-4 h-4 text-primary-500 rounded">
                            <span class="ml-3 text-gray-900 font-semibold">Email me promotional offers</span>
                        </label>
                        <p class="text-sm text-gray-600 ml-7 mt-1">Receive special discounts and early access to new features</p>
                    </div>
                    
                    <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-semibold">
                        Save Preferences
                    </button>
                </div>
            </div>
            

            <div x-show="tab === 'security'" class="bg-white rounded-lg shadow p-6 space-y-6">
                <h2 class="text-2xl font-bold text-gray-900">Security</h2>
                
                <div class="space-y-4">
                    
                    <div class="border border-gray-200 rounded p-4">
                        <div class="flex items-center justify-between mb-2">
                            <h3 class="font-semibold text-gray-900">Two-Factor Authentication</h3>
                            <button class="text-primary-600 hover:text-primary-700 font-semibold text-sm">Enable</button>
                        </div>
                        <p class="text-sm text-gray-600">Add an extra layer of security to your account</p>
                    </div>
                    
                    <div class="border border-gray-200 rounded p-4">
                        <div class="flex items-center justify-between mb-2">
                            <h3 class="font-semibold text-gray-900">Login History</h3>
                            <a href="#" class="text-primary-600 hover:text-primary-700 font-semibold text-sm">View</a>
                        </div>
                        <p class="text-sm text-gray-600">See where and when you've signed in</p>
                    </div>
                    
                    <div class="border border-red-200 bg-red-50 rounded p-4">
                        <div class="flex items-center justify-between mb-2">
                            <h3 class="font-semibold text-red-900">Sign Out All Devices</h3>
                            <button class="text-red-600 hover:text-red-700 font-semibold text-sm">Sign Out</button>
                        </div>
                        <p class="text-sm text-red-700">End all active sessions on other devices</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
