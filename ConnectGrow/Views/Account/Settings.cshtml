@using ConnectGrow.Services
@model ConnectGrow.Models.SettingsViewModel
@{
    ViewBag.Title = "Account Settings";
}

<section class="bg-white border-b border-gray-200 py-8">
    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold text-gray-900">Account Settings</h1>
        <p class="text-gray-700">Manage your profile and preferences</p>
    </div>
</section>

<section class="py-12 bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4 max-w-2xl">

        <div x-data="{ tab: '@Model.ActiveTab' }" class="space-y-6">

            <div class="flex gap-2 bg-white rounded-lg p-2 shadow border border-gray-200">
                <button x-on:click="tab = 'profile'"
                    :class="tab === 'profile' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2 rounded font-semibold transition-smooth">
                    <img src="~/images/personsingle.png" alt="" class="w-5 h-5 object-contain flex-shrink-0" />
                    <span>Profile</span>
                </button>
                <button x-on:click="tab = 'password'"
                    :class="tab === 'password' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2 rounded font-semibold transition-smooth">
                    <img src="~/images/password.png" alt="" class="w-5 h-5 object-contain flex-shrink-0" />
                    <span>Password</span>
                </button>
                <button x-on:click="tab = 'security'"
                    :class="tab === 'security' ? 'bg-primary-500 text-white' : 'bg-white text-gray-700 hover:bg-gray-100'"
                    class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2 rounded font-semibold transition-smooth">
                    <img src="~/images/security.png" alt="" class="w-5 h-5 object-contain flex-shrink-0" />
                    <span>Account</span>
                </button>
            </div>

            @*  PROFILE *@
            <div x-show="tab === 'profile'" class="bg-white rounded-lg shadow p-6 space-y-6">
                <h2 class="text-2xl font-bold text-gray-900">Profile Information</h2>

                <form asp-controller="Account" asp-action="UpdateProfile" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" role="alert"
                         class="bg-red-50 border border-red-200 text-red-800 p-4 rounded text-sm empty:hidden"></div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Profile.FirstName" class="block text-sm font-semibold text-gray-900 mb-2">First Name</label>
                            <input asp-for="Profile.FirstName" autocomplete="given-name"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                            <span asp-validation-for="Profile.FirstName" class="text-sm text-red-700"></span>
                        </div>
                        <div>
                            <label asp-for="Profile.LastName" class="block text-sm font-semibold text-gray-900 mb-2">Last Name</label>
                            <input asp-for="Profile.LastName" autocomplete="family-name"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                            <span asp-validation-for="Profile.LastName" class="text-sm text-red-700"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Profile.Email" class="block text-sm font-semibold text-gray-900 mb-2">Email Address</label>
                        <input asp-for="Profile.Email" type="email" autocomplete="username"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                     
                        <p class="text-xs text-gray-600 mt-1">
                            Booking confirmations and recording links are sent here.
                        </p>
                        <span asp-validation-for="Profile.Email" class="text-sm text-red-700"></span>
                    </div>

                    <div>
                        <label asp-for="Profile.PhoneNumber" class="block text-sm font-semibold text-gray-900 mb-2">Phone Number</label>
                        <input asp-for="Profile.PhoneNumber" type="tel" autocomplete="tel" placeholder="+27 (0)XX XXX XXXX"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <span asp-validation-for="Profile.PhoneNumber" class="text-sm text-red-700"></span>
                    </div>

                    <div>
                        <label asp-for="Profile.Organisation" class="block text-sm font-semibold text-gray-900 mb-2">Practice or Organisation</label>
                        <input asp-for="Profile.Organisation" autocomplete="organization"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <p class="text-xs text-gray-600 mt-1">Printed on your CPD certificates.</p>
                    </div>

                    <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-semibold">
                        Save Changes
                    </button>
                </form>
            </div>

            @*PASSWORD *@
            <div x-show="tab === 'password'" class="bg-white rounded-lg shadow p-6 space-y-6">
                <h2 class="text-2xl font-bold text-gray-900">Change Password</h2>


                <div class="bg-blue-50 border border-blue-200 rounded p-4">
                    <p class="text-sm text-blue-900">
                        Changing your password signs you out everywhere, including here.
                        You'll be asked to sign in again with the new password.
                    </p>
                </div>

                <form asp-controller="Account" asp-action="ChangePassword" method="post" class="space-y-4 max-w-md">
                    @Html.AntiForgeryToken()

                    <div>
                        <label asp-for="Password.CurrentPassword" class="block text-sm font-semibold text-gray-900 mb-2">Current Password</label>
                        <input asp-for="Password.CurrentPassword" type="password" autocomplete="current-password"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <span asp-validation-for="Password.CurrentPassword" class="text-sm text-red-700"></span>
                    </div>

                    <div>
                        <label asp-for="Password.NewPassword" class="block text-sm font-semibold text-gray-900 mb-2">New Password</label>
                        <input asp-for="Password.NewPassword" type="password" autocomplete="new-password"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <p class="text-xs text-gray-600 mt-1">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</p>
                        <span asp-validation-for="Password.NewPassword" class="text-sm text-red-700"></span>
                    </div>

                    <div>
                        <label asp-for="Password.ConfirmPassword" class="block text-sm font-semibold text-gray-900 mb-2">Confirm New Password</label>
                        <input asp-for="Password.ConfirmPassword" type="password" autocomplete="new-password"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <span asp-validation-for="Password.ConfirmPassword" class="text-sm text-red-700"></span>
                    </div>

                    <button type="submit" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-semibold">
                        Update Password
                    </button>
                </form>
            </div>


            @*  ACCOUNT *@
            <div x-show="tab === 'security'" class="bg-white rounded-lg shadow p-6 space-y-6">
                <h2 class="text-2xl font-bold text-gray-900">Account</h2>

                <dl class="space-y-4">
                    <div class="border border-gray-200 rounded p-4">
                        <dt class="text-sm font-semibold text-gray-900">Member since</dt>
                        <dd class="text-sm text-gray-700 mt-1">@Model.MemberSince.ToSastDate()</dd>
                    </div>

                    <div class="border border-gray-200 rounded p-4">
                        <dt class="text-sm font-semibold text-gray-900">Account type</dt>
                        <dd class="text-sm text-gray-700 mt-1">
                            @(Model.Roles.Contains("Admin") ? "Administrator" : "Registered attendee")
                        </dd>
                    </div>
                </dl>

                <div class="border border-gray-200 rounded p-4">
                    <h3 class="font-semibold text-gray-900 mb-1">Sign out of all devices</h3>
                    <p class="text-sm text-gray-600 mb-3">
                        Changing your password ends every active session, including on
                        devices you no longer have.
                    </p>
                    <button type="button" x-on:click="tab = 'password'"
                            class="px-4 py-2 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 font-semibold text-sm">
                        Change password
                    </button>
                </div>

                <div class="border border-gray-200 rounded p-4">
                    <h3 class="font-semibold text-gray-900 mb-1">Sign out</h3>
                    <p class="text-sm text-gray-600 mb-3">End your session on this device.</p>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="px-4 py-2 bg-red-50 text-red-700 rounded hover:bg-red-100 font-semibold text-sm">
                            Sign Out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
