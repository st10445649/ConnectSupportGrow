@model ConnectGrow.Models.RegisterInputModel
@{
    ViewBag.Title = "Create Account";
}

<section class="min-h-screen flex items-center justify-center bg-gradient-primary py-12 px-4">
    <div class="max-w-md w-full">
        
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Join Us</h1>
            <p class="text-gray-700">Create your Connect Grow Support account</p>
        </div>


    <form method="post" class="mt-8 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" role="alert"
             class="rounded border border-red-200 bg-red-50 p-3 text-sm text-red-800 empty:hidden"></div>
        
        <div class="bg-white rounded-lg shadow-xl p-8 space-y-4">

            <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="FirstName" class="block text-sm font-semibold text-gray-900 mb-2"></label>
                <input asp-for="FirstName" autocomplete="given-name" required placeholder="Jane Doe"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth" />
                <span asp-validation-for="FirstName" class="text-sm text-red-700"></span>
            </div>
            <div>
                <label asp-for="LastName" class="block text-sm font-semibold text-gray-900 mb-2"></label>
                <input asp-for="LastName" autocomplete="family-name"
                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth" />
                <span asp-validation-for="LastName" class="text-sm text-red-700"></span>
            </div>
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-semibold text-gray-900 mb-2">Email Address</label>
            <input asp-for="Email" type="email" autocomplete="username" required placeholder="you@example.com"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
            <span asp-validation-for="Email" class="text-sm text-red-700"></span>
        </div>

        <div>
            <label asp-for="Organisation" class="block text-sm font-semibold text-gray-900 mb-2">Organisation</label>
            <input asp-for="Organisation" autocomplete="organization"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
            <p class="mt-1 text-xs text-slate-500">Optional</p>
        </div>


        <div>
            <label asp-for="Password" class="block text-sm font-semibold text-gray-900 mb-2">Password</label>
            <input asp-for="Password" type="password" autocomplete="new-password"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
            <p class="mt-1 text-xs text-slate-500">
                At least 8 characters, with an uppercase letter, a lowercase letter and a number.
            </p>
            <span asp-validation-for="Password" class="text-sm text-red-700"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-medium"></label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 transition-smooth">
            <span asp-validation-for="ConfirmPassword" class="text-sm text-red-700"></span>
        </div>

            <!-- Terms Checkbox -->
            <label class="flex items-start mt-4">
                <input type="checkbox" name="agreeTerms" required class="w-4 h-4 text-primary-500 rounded mt-1">
                <span class="ml-2 text-sm text-gray-700">
                    I agree to the 
                    <a href="#" class="text-primary-600 hover:underline font-semibold">Terms of Service</a> and 
                    <a href="#" class="text-primary-600 hover:underline font-semibold">Privacy Policy</a>
                </span>
            </label>
            
            <!-- Submit -->
            <button type="submit" class="w-full py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-lg mt-6">
                Create Account
            </button>
            </form>
        </div>
        
        <p class="text-center text-gray-700 mt-6">
            Already have an account? 
            <a href="/account/login" class="text-primary-600 hover:text-primary-700 font-bold">Sign in here</a>
        </p>
    </div>
</section>