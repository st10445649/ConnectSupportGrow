@using ConnectGrow.Services
@model ConnectGrow.Models.Bookings
@{
    ViewBag.Title = Model.IsPaid ? "Booking Confirmed" : "Confirming Your Booking";
}

@*
    This page does NOT confirm payment — it only reads the booking.
 Payment is confirmed only by the verified ITN callback from Payfast to the API,
    which arrives server-to-server and may land a second or two after the buyer
    is redirected here. 
*@

<section class="min-h-screen flex items-center justify-center bg-gradient-primary py-12 px-4">
    <div class="max-w-md w-full bg-white rounded-lg shadow-xl p-8">

        <div class="text-center mb-6">
            @if (Model.IsPaid)
            {
                <div class="text-6xl mb-4">✓</div>
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Booking Confirmed!</h1>
                <p class="text-gray-700">Thank you for registering</p>
            }
            else
            {
                <div class="text-6xl mb-4">⏳</div>
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Confirming Your Booking</h1>
                <p class="text-gray-700">
                    We're waiting for confirmation from the payment provider. This usually
                    takes a few seconds.
                </p>
            }
        </div>

        <div class="gradient-primary border rounded-lg p-6 mb-6 space-y-4">

            <div>
                <p class="text-xs font-semibold text-gray-600 mb-1">Confirmation Number</p>
                <p class="text-lg font-mono font-bold text-primary-600">@Model.BookingReference</p>
            </div>

            <div>
                <p class="text-xs font-semibold text-gray-600 mb-1">Webinar</p>
                <p class="text-gray-900 font-semibold">@Model.WebinarTitle</p>
            </div>

            <div>
                <p class="text-xs font-semibold text-gray-600 mb-1">Date &amp; Time</p>
                <p class="text-gray-900 font-semibold">
                    @Model.StartDateTime.ToSastDate() · @Model.StartDateTime.ToSastTime() SAST
                </p>
            </div>

            <div>
                <p class="text-xs font-semibold text-gray-600 mb-1">
                    @(Model.IsPaid ? "Amount Paid" : "Amount Due")
                </p>
                <p class="text-gray-900 font-semibold">R@Model.Amount.ToString("N2")</p>
            </div>

            @if (Model.CpdPoints > 0)
            {
                <div>
                    <p class="text-xs font-semibold text-gray-600 mb-1">CPD Points</p>
                    <p class="text-gray-900 font-semibold">
                        @Model.CpdPoints points on confirmed attendance
                    </p>
                </div>
            }
        </div>

        <div class="space-y-3 mb-6">
            @if (Model.IsPaid)
            {
                <div class="bg-blue-50 border border-blue-200 rounded p-4">
                    <p class="text-sm text-blue-900">
                        <strong>Check your email</strong> for your Microsoft Teams link, a calendar
                        invitation and your receipt.
                    </p>
                </div>

                <div class="bg-green-50 border border-green-200 rounded p-4">
                    <p class="text-sm text-green-900">
                        <strong>Recording access:</strong> if you miss the live session, you'll be
                        emailed a personal viewing link once the recording is ready.
                    </p>
                </div>
            }
            else
            {
                <div class="bg-amber-50 border border-amber-200 rounded p-4">
                    <p class="text-sm text-amber-900">
                        <strong>Nothing to do right now.</strong> If you completed payment, this page
                        will show as confirmed shortly — refresh in a moment, or check your dashboard.
                        Your seat is held in the meantime.
                    </p>
                </div>
            }
        </div>

        @*
            Receipt and calendar downloads are generated by the API on payment
            confirmation. will be added later
        *@
        <div class="space-y-3 mb-6">
            @if (Model.IsPaid && !string.IsNullOrWhiteSpace(Model.JoinUrl))
            {
                <a href="@Model.JoinUrl" target="_blank" rel="noopener noreferrer"
                   class="block w-full py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-semibold text-center transition-smooth">
                    Join Link
                </a>
            }
        </div>

        <a asp-controller="Dashboard" asp-action="Index"
           class="block text-center text-primary-600 hover:text-primary-700 font-semibold">
            Go to Dashboard →
        </a>
    </div>
</section>
