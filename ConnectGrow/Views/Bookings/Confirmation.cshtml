
@{
    ViewBag.Title = "Booking Confirmed";
}

<section class="min-h-screen flex items-center justify-center bg-gradient-primary py-12 px-4">
    <div class="max-w-md w-full bg-white rounded-lg shadow-xl p-8">
        
       
        <div class="text-center mb-6">
            <div class="text-6xl mb-4">✓</div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Booking Confirmed!</h1>
            <p class="text-gray-700">Thank you for registering</p>
        </div>
        
       
        <div class="gradient-primary border rounded-lg p-6 mb-6 space-y-4">
            
            <div>
                <p class="text-xs font-semibold text-gray-600 mb-1">Confirmation Number</p>
                <p class="text-lg font-mono font-bold text-primary-600">BK-20260715-001</p>
            </div>
            
            <div>
                <p class="text-xs font-semibold text-gray-600 mb-1">Webinar</p>
                <p class="text-gray-900 font-semibold">Autism Spectrum Awareness in the Classroom</p>
            </div>
            
            <div>
                <p class="text-xs font-semibold text-gray-600 mb-1">Date & Time</p>
                <p class="text-gray-900 font-semibold">July 15, 2026 · 2:00 PM SAST</p>
            </div>
            
            <div>
                <p class="text-xs font-semibold text-gray-600 mb-1">Amount Paid</p>
                <p class="text-gray-900 font-semibold">R155.00 (including platform fee)</p>
            </div>
        </div>
        
        <div class="space-y-3 mb-6">
            <div class="bg-blue-50 border border-blue-200 rounded p-4">
                <p class="text-sm text-blue-900">
                    <strong>Check your email</strong> for your Microsoft Teams link and webinar details. 
                    This will be sent 24 hours before the session.
                </p>
            </div>
            
            <div class="bg-green-50 border border-green-200 rounded p-4">
                <p class="text-sm text-green-900">
                    <strong>Recording access:</strong> This webinar will be recorded. If you miss the live session, 
                    you'll have access to the recording for 30 days.
                </p>
            </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="space-y-3 mb-6">
            <a href="/account/download-receipt/123" class="block w-full py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-semibold text-center transition-smooth">
                Download Receipt
            </a>
            <a href="/account/add-to-calendar/123" class="block w-full py-2 border-2 border-primary-500 text-primary-600 rounded-lg hover:bg-primary-50 font-semibold text-center transition-smooth">
                + Add to Calendar
            </a>
        </div>
        
        <!-- Dashboard Link -->
        <a href="/dashboard" class="block text-center text-primary-600 hover:text-primary-700 font-semibold">
            Go to Dashboard →
        </a>
    </div>
</section>
