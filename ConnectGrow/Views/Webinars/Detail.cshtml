@using ConnectGrow.Services
@model ConnectGrow.Models.WebinarDetailModel
@{
    ViewBag.Title = $"{Model.Title} - Webinar Details";
    var fillPercent = ViewHelpers.FillPercentage(Model.Capacity, Model.AvailableSeats);
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<div class="max-w-7xl mx-auto px-4 py-8">

<div class="bg-gray-50 border-b border-gray-200 py-3 px-4">
    <div class="container mx-auto text-sm text-gray-600">
        <a href="/" class="hover:text-primary-600">Home</a> /
        <a asp-controller="Webinars" asp-action="Index" class="hover:text-primary-600">Webinars</a> /
        <span class="text-gray-900">@Model.Title</span>
    </div>
</div>

@if (TempData["Error"] is string bookingError)
{
    @* Where a failed booking lands: already booked, sold out, or payment
       unavailable. The message comes straight from the API. *@
    <div role="alert" class="container mx-auto px-4 mt-4">
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-800">
            @bookingError
        </div>
    </div>
}

<section class="bg-gradient-primary py-12 md:py-16">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

            <div class="md:col-span-2">
                <div class="bg-white rounded-lg p-8 text-center mb-4">
                    <img src="@ViewHelpers.WebinarImage(Model.FeaturedImageUrl)"
                         alt="@Model.Title"
                         class="w-full h-48 sm:h-64 md:h-80 lg:h-96 object-cover" />
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 mt-6">
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">Description</h2>
                    <p class="text-gray-700 leading-relaxed mb-4" style="white-space: pre-line">@Model.Description</p>

                    @if (Model.LearningOutcomes.Any())
                    {
                        <h3 class="text-xl font-bold text-gray-900 mb-3 mt-6">Learning Outcomes</h3>
                        <ul class="list-disc list-inside space-y-2 text-gray-700">
                            @foreach (var outcome in Model.LearningOutcomes)
                            {
                                <li>@outcome</li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="md:col-span-1">
            <div class="bg-white rounded-lg shadow-lg p-6 h-fit">
                <div class="inline-block px-3 py-1 @ViewHelpers.CategoryBadgeClasses(Model.Category) rounded-full text-xs font-bold mb-4 w-fit uppercase">
                    @Model.Category
                </div>

                <h1 class="text-2xl font-bold text-gray-900 mb-4">
                    @Model.Title
                </h1>

                <div class="space-y-3 border-t border-gray-200 pt-4 mb-6">
                    <div class="flex items-start gap-3">
                        <img src="~/images/calendaricon.png" alt="Date" class="w-6 h-6 flex-shrink-0 mt-0.5" />
                        <div>
                            <p class="text-xs text-gray-600">Date &amp; Time</p>
                            <p class="font-semibold text-gray-900">@Model.StartDateTime.ToSastDate()</p>
                            <p class="text-sm text-gray-700">@Model.StartDateTime.ToSastRange(Model.EndDateTime)</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <img src="~/images/timeicon.png" alt="Duration" class="w-6 h-6 flex-shrink-0 mt-0.5" />
                        <div>
                            <p class="text-xs text-gray-600">Duration</p>
                            <p class="font-semibold text-gray-900">@ViewHelpers.DurationLabel(Model.StartDateTime, Model.EndDateTime)</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3">
                        <img src="~/images/coinicon.png" alt="Price" class="w-6 h-6 flex-shrink-0 mt-0.5" />
                        <div>
                            <p class="text-xs text-gray-600">Price</p>
                            <p class="font-bold text-2xl text-primary-600">
                                @(Model.IsFree ? "Free" : $"R{Model.Price:N0}")
                            </p>
                            <p class="text-xs text-gray-600">One-time payment</p>
                        </div>
                    </div>

                    @if (Model.CpdPoints > 0)
                    {
                        <div class="flex items-start gap-3">
                            <img src="~/images/bookicon.png" alt="CPD" class="w-6 h-6 flex-shrink-0 mt-0.5" />
                            <div>
                                <p class="text-xs text-gray-600">CPD Points</p>
                                <p class="font-semibold text-gray-900">@Model.CpdPoints Points</p>
                            </div>
                        </div>
                    }

                    <div class="flex items-start gap-3">
                        <img src="~/images/personicon.png" alt="Availability" class="w-6 h-6 flex-shrink-0 mt-0.5" />
                        <div class="flex-grow">
                            <p class="text-xs text-gray-600">Availability</p>
                            <p class="font-semibold text-gray-900">@Model.AvailableSeats / @Model.Capacity Spots</p>
                            <div class="w-full bg-gray-200 rounded-full h-2 mt-1">
                                <div class="bg-primary-500 h-2 rounded-full" style="width: @(fillPercent)%"></div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.IsSoldOut)
                {
                    <button type="button" disabled
                            class="w-full py-3 bg-gray-300 text-white rounded-lg font-bold text-center block mb-3 cursor-not-allowed">
                        Sold Out
                    </button>
                    <p class="text-xs text-gray-600 text-center">
                        This session is full. New dates are announced regularly.
                    </p>
                }
                else if (isAuthenticated)
                {
                    <form asp-controller="Bookings" asp-action="Create" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="webinarId" value="@Model.Id" />
                        <button type="submit"
                                class="w-full py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-center block">
                            @(Model.IsFree ? "Reserve My Place" : $"Book Now for R{Model.Price:N0}")
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Detail", "Webinars", new { id = Model.Id })"
                       class="w-full py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-center block mb-3">
                        Sign In to Book
                    </a>
                    <p class="text-xs text-gray-600 text-center mb-3">
                        You'll come straight back here afterwards.
                    </p>
                }

                <a asp-controller="Dashboard" asp-action="Index"
                   class="w-full py-2 border-2 border-primary-500 text-primary-600 rounded-lg hover:bg-primary-50 transition-smooth font-semibold text-center block">
                    View My Bookings
                </a>
            </div>
        </div>
    </div>
</section>

<section class="py-12 md:py-16">
    <div class="container mx-auto px-4">

        <div x-data="{ activeTab: 'overview' }" class="max-w-4xl">

            <div class="flex gap-4 border-b border-gray-200 mb-8 overflow-x-auto">
                <button x-on:click="activeTab = 'overview'"
                    :class="activeTab === 'overview' ? 'border-primary-500 text-primary-600' : 'border-transparent text-gray-600'"
                    class="px-4 py-3 border-b-2 font-semibold transition-smooth whitespace-nowrap">
                    Overview
                </button>
                @if (Model.LearningOutcomes.Any())
                {
                    <button x-on:click="activeTab = 'details'"
                        :class="activeTab === 'details' ? 'border-primary-500 text-primary-600' : 'border-transparent text-gray-600'"
                        class="px-4 py-3 border-b-2 font-semibold transition-smooth whitespace-nowrap">
                        What You'll Learn
                    </button>
                }
                @if (!string.IsNullOrWhiteSpace(Model.PresenterName))
                {
                    <button x-on:click="activeTab = 'speaker'"
                        :class="activeTab === 'speaker' ? 'border-primary-500 text-primary-600' : 'border-transparent text-gray-600'"
                        class="px-4 py-3 border-b-2 font-semibold transition-smooth whitespace-nowrap">
                        Speaker
                    </button>
                }
                <button x-on:click="activeTab = 'faq'"
                    :class="activeTab === 'faq' ? 'border-primary-500 text-primary-600' : 'border-transparent text-gray-600'"
                    class="px-4 py-3 border-b-2 font-semibold transition-smooth whitespace-nowrap">
                    FAQ
                </button>
            </div>

            <div x-show="activeTab === 'overview'" class="space-y-6">
                <div>
                    <h2 class="text-3xl font-bold text-gray-900 mb-4">About This Webinar</h2>
                    <p class="text-lg text-gray-700 mb-4 leading-relaxed" style="white-space: pre-line">@Model.Description</p>
                </div>

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                    <h3 class="font-bold text-blue-900 mb-2">Webinar Delivery</h3>
                    <p class="text-blue-900 mb-2">
                        <strong>Format:</strong> Live Microsoft Teams Meeting with Q&amp;A
                    </p>
                    <p class="text-blue-900 mb-2">
                        <strong>Recording:</strong> Made available to registered attendees after the session
                    </p>
                    <p class="text-blue-900">
                        <strong>Materials:</strong> Downloadable slides and resource list provided
                    </p>
                </div>
            </div>

            @if (Model.LearningOutcomes.Any())
            {
                <div x-show="activeTab === 'details'" class="space-y-6">
                    <h2 class="text-3xl font-bold text-gray-900">Learning Outcomes</h2>

                    <div class="space-y-4">
                        @foreach (var outcome in Model.LearningOutcomes)
                        {
                            <div class="flex gap-4">
                                <div class="flex-shrink-0 w-8 h-8 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center font-bold">
                                    ✓
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900 mb-1">@outcome</h3>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.PresenterName))
            {
                <div x-show="activeTab === 'speaker'" class="space-y-6">
                    <h2 class="text-3xl font-bold text-gray-900 mb-6">Meet Your Presenter</h2>

                    <div class="flex gap-6 flex-col md:flex-row">
                        <div class="w-24 h-24 md:w-32 md:h-32 bg-primary-200 rounded-lg flex-shrink-0 flex items-center">
                            <img src="~/images/presentericon.png" alt="Presenter" class="w-full h-full object-cover" />
                        </div>

                        <div class="flex-grow">
                            <h3 class="text-2xl font-bold text-gray-900 mb-2">@Model.PresenterName</h3>

                            @if (!string.IsNullOrWhiteSpace(Model.PresenterBio))
                            {
                                <p class="text-gray-700 mb-4 leading-relaxed" style="white-space: pre-line">@Model.PresenterBio</p>
                            }
                        </div>
                    </div>
                </div>
            }

            @* Static for now. Connect to the FAQ endpoint once the API exposes it,
               so the admin can edit these without a deployment. *@
            <div x-show="activeTab === 'faq'" class="space-y-4">
                <h2 class="text-3xl font-bold text-gray-900 mb-6">Frequently Asked Questions</h2>

                <div x-data="{ open: false }" class="border border-gray-200 rounded-lg p-4 hover:border-primary-300 transition-smooth">
                    <button x-on:click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                        <span>How do I join the webinar?</span>
                        <span x-text="open ? '▼' : '▶'"></span>
                    </button>
                    <p x-show="open" class="mt-3 text-gray-700">
                        After booking you'll receive a Microsoft Teams link by email, along with a calendar
                        invitation. Click the link at the scheduled time — nothing needs to be installed,
                        joining through your browser works.
                    </p>
                </div>

                <div x-data="{ open: false }" class="border border-gray-200 rounded-lg p-4 hover:border-primary-300 transition-smooth">
                    <button x-on:click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                        <span>What if I can't attend live? Is there a recording?</span>
                        <span x-text="open ? '▼' : '▶'"></span>
                    </button>
                    <p x-show="open" class="mt-3 text-gray-700">
                        Webinars are recorded and made available to registered attendees. You'll be emailed a
                        personal viewing link with an expiry date once the recording is ready.
                    </p>
                </div>

                <div x-data="{ open: false }" class="border border-gray-200 rounded-lg p-4 hover:border-primary-300 transition-smooth">
                    <button x-on:click="open = !open" class="w-full text-left flex items-center justify-between font-semibold text-gray-900 hover:text-primary-600">
                        <span>How do I claim CPD points?</span>
                        <span x-text="open ? '▼' : '▶'"></span>
                    </button>
                    <p x-show="open" class="mt-3 text-gray-700">
                        CPD points are credited once attendance is confirmed after the session. Your certificate
                        is then available to download from your dashboard.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="gradient-primary py-12 md:py-16 border-t border-gray-200">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Ready to Book?</h2>
        <p class="text-lg text-gray-700 mb-8 max-w-2xl mx-auto">
            @if (Model.IsSoldOut)
            {
                <text>This session is fully booked. Browse our other upcoming webinars.</text>
            }
            else
            {
                <text>@Model.AvailableSeats spots remaining. Secure your place in this professional development webinar.</text>
            }
        </p>

        @if (Model.IsSoldOut)
        {
            <a asp-controller="Webinars" asp-action="Index"
               class="inline-block px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-lg">
                Browse Other Webinars
            </a>
        }
        else if (isAuthenticated)
        {
            <form asp-controller="Bookings" asp-action="Create" method="post" class="inline-block">
                @Html.AntiForgeryToken()
                <input type="hidden" name="webinarId" value="@Model.Id" />
                <button type="submit"
                        class="px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-lg">
                    @(Model.IsFree ? "Reserve My Place" : $"Book Now for R{Model.Price:N0}")
                </button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login"
               asp-route-returnUrl="@Url.Action("Detail", "Webinars", new { id = Model.Id })"
               class="inline-block px-8 py-4 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-smooth font-bold text-lg">
                Sign In to Book
            </a>
        }
    </div>
</section>
