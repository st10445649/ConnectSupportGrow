}


<div class="bg-gray-50 border-b border-gray-200 py-3 px-4">
    <div class="container mx-auto text-sm text-gray-600">
        <a href="/" class="hover:text-primary-600">Home</a> / 
        <a href="/webinars" class="hover:text-primary-600">Webinars</a> / 
        <span class="text-gray-900">Autism Spectrum Awareness in the Classroom</span>
    </div>
</div>

<section class="bg-gradient-primary py-12 md:py-16">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            @* Left: Image/Icon *@
