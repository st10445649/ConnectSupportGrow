@model List<ConnectGrow.Models.Webinars>
@using ConnectGrow.Services
@{
    ViewBag.Title = "Webinars";
    var selectedCategory = ViewBag.SelectedCategory as string;
    var selectedSort = ViewBag.SelectedSort as string;
}

<section class="gradient-primary py-12 md:py-16">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Upcoming Webinars</h1>
        <p class="text-lg text-gray-700">Discover expert-led training sessions designed for your professional growth</p>
    </div>
</section>

<section class="bg-white border-b border-gray-200 py-6 sticky top-20 z-40">
    <div class="container mx-auto px-4">
        <form method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-4 gap-4">

            <div class="md:col-span-2" x-data>
                <input type="text" placeholder="Search webinars..."
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
                       x-on:input="
                           const term = $el.value.toLowerCase();
                           document.querySelectorAll('[data-webinar-card]').forEach(card => {
                               card.style.display =
                                   card.dataset.search.includes(term) ? '' : 'none';
                           });">
            </div>

            <select name="category" onchange="this.form.submit()"
                    class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                <option value="">All Categories</option>
                <option value="Educators" selected="@(selectedCategory == "Educators")">For Educators</option>
                <option value="Parents" selected="@(selectedCategory == "Parents")">For Parents</option>
                <option value="Professionals" selected="@(selectedCategory == "Professionals")">For Professionals</option>
                <option value="General" selected="@(selectedCategory == "General")">General</option>
            </select>

            <select name="sort" onchange="this.form.submit()"
                    class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                <option value="">Upcoming First</option>
                <option value="price-low" selected="@(selectedSort == "price-low")">Price: Low to High</option>
                <option value="price-high" selected="@(selectedSort == "price-high")">Price: High to Low</option>
                <option value="cpd" selected="@(selectedSort == "cpd")">CPD Points: High to Low</option>
            </select>
        </form>
    </div>
</section>

<section class="py-12 md:py-16">
    <div class="container mx-auto px-4">

        @if (ViewBag.Error is not null)
        {
            <div role="alert" class="mb-8 bg-red-50 border border-red-200 rounded-lg p-4 text-red-800">
                @ViewBag.Error
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-16">
                <p class="text-xl text-gray-700 mb-4">
                    @(string.IsNullOrEmpty(selectedCategory)
                        ? "No webinars are scheduled at the moment."
                        : $"No webinars in the {selectedCategory} category right now.")
                </p>
                @if (!string.IsNullOrEmpty(selectedCategory))
                {
                    <a asp-action="Index" class="text-primary-600 font-bold hover:underline">
                        Browse all webinars
                    </a>
                }
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">

                @foreach (var webinar in Model)
                {
                    <div data-webinar-card
                         data-search="@($"{webinar.Title} {webinar.Category} {webinar.PresenterName}".ToLowerInvariant())"
                         class="bg-white rounded-lg shadow hover:shadow-lg transition-smooth overflow-hidden border border-gray-100 flex flex-col">

                        <div class="h-48 bg-gradient-primary flex items-center justify-center text-6xl">
                            <img src="@ViewHelpers.WebinarImage(webinar.FeaturedImageUrl)"
                                 alt="@webinar.Title"
                                 class="w-full h-40 sm:h-48 md:h-56 object-cover" />
                        </div>

                        <div class="p-6 flex flex-col flex-grow">

                            <div class="inline-block px-3 py-1 @ViewHelpers.CategoryBadgeClasses(webinar.Category) rounded-full text-xs font-semibold mb-3 w-fit">
                                @webinar.Category
                            </div>

                            <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2">
                                @webinar.Title
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(webinar.PresenterName))
                            {
                                <p class="text-sm text-gray-600 mb-4 flex-grow">
                                    Presented by @webinar.PresenterName
                                </p>
                            }
                            else
                            {
                                <div class="flex-grow"></div>
                            }

                            <div class="space-y-2 text-sm text-gray-700 border-t border-gray-200 pt-4 mb-4">
                                <div class="flex items-center gap-2">
                                    <img src="~/images/calendaricon.png" alt="Date" class="w-6 h-6 flex-shrink-0 mt-0.5" />
                                    
                                    <span>@webinar.StartDateTime.ToSastDisplay()</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <img src="~/images/timeicon.png" alt="Duration" class="w-6 h-6 flex-shrink-0 mt-0.5" />
                                    <span>@ViewHelpers.DurationLabel(webinar.StartDateTime, webinar.EndDateTime)</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <img src="~/images/coinicon.png" alt="Price" class="w-6 h-6 flex-shrink-0 mt-0.5" />
                                    <span class="font-semibold">
                                        @(webinar.IsFree ? "Free" : $"R{webinar.Price:N0} ZAR")
                                    </span>
                                </div>
                                @if (webinar.CpdPoints > 0)
                                {
                                    <div class="flex items-center gap-2">
                                        <img src="~/images/bookicon.png" alt="CPD" class="w-6 h-6 flex-shrink-0 mt-0.5" />
                                        <span class="font-semibold">@webinar.CpdPoints CPD Points</span>
                                    </div>
                                }
                                <div class="flex items-center gap-2">
                                    <img src="~/images/personicon.png" alt="Availability" class="w-6 h-6 flex-shrink-0 mt-0.5" />
                                    @if (webinar.IsSoldOut)
                                    {
                                        <span class="font-semibold text-red-600">Sold out</span>
                                    }
                                    else
                                    {
                                        <span>@webinar.AvailableSeats / @webinar.Capacity spots available</span>
                                    }
                                </div>
                            </div>

                            <a asp-action="Detail" asp-route-id="@webinar.Id"
                               class="w-full py-2 bg-primary-500 text-white rounded hover:bg-primary-600 transition-smooth font-semibold text-center block">
                                View Details
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="gradient-primary py-12 md:py-16">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Didn't find what you're looking for?</h2>
        <p class="text-gray-700 mb-6">Check back soon for new webinars, or <a href="#" class="text-primary-600 font-bold hover:underline">subscribe to updates</a>.</p>
    </div>
</section>
