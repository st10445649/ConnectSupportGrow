</section>

<section class="gradient-primary py-12 md:py-16">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Didn't find what you're looking for?</h2>
        <p class="text-gray-700 mb-6">Check back soon for new webinars, or <a href="#" class="text-primary-600 font-bold hover:underline">subscribe to updates</a>.</p>
    </div>
</section>
