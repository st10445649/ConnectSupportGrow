                    </a>
                </div>
            </div>
            
            <div class="bg-white rounded-lg shadow hover:shadow-lg transition-smooth overflow-hidden border border-gray-100 flex flex-col">
                <div class="h-40 bg-gradient-accent flex items-center justify-center text-5xl">
                    💬
                </div>
                <div class="p-6 flex flex-col flex-grow">
                    <div class="inline-block px-3 py-1 bg-secondary-100 text-secondary-700 rounded-full text-xs font-semibold mb-3 w-fit">
