@{
    ViewBag.Title = "Send Recording Links";
}

<section class="bg-white border-b border-gray-200 py-8">
    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold text-gray-900">Send Recording Links</h1>
        <p class="text-gray-700">Email recording links to all attendees</p>
    </div>
</section>

<section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4 max-w-2xl">
        
        <div class="bg-white rounded-lg shadow p-8 space-y-6">
            
            <!-- Webinar Selector -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">Select Webinar</label>
                <select required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                    <option>Choose a webinar...</option>
                    <option selected>AAC Basics (June 28, 2026)</option>
                    <option>Hearing Loss & Accommodations (June 14, 2026)</option>
                </select>
            </div>
            
            <!-- Email Preview -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">Email Template Preview</label>
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 font-mono text-sm">
                    <p><strong>To:</strong> 32 attendees</p>
                    <p><strong>Subject:</strong> Your Recording: AAC Basics</p>
                    <p class="mt-4 leading-relaxed">
                        Hi {FirstName},<br><br>
                        
                        Thank you for attending "AAC Basics"! Your recording is now available.<br><br>
                        
                        <strong>Recording Link:</strong> {RecordingUrl}<br>
                        <strong>Access Expires:</strong> {ExpiryDate}<br><br>
                        
                        You can watch at your own pace. Download the slides and resources from your dashboard.<br><br>
                        
                        We'd love your feedback! <a href="#">Leave an evaluation</a><br><br>
                        
                        Best regards,<br>
                        Connect Grow Support
                    </p>
                </div>
            </div>
            
            <!-- Recipients -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">Recipients</label>
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <p class="text-sm text-blue-900">
                        <strong>32 attendees</strong> from "AAC Basics" will receive this email.
                    </p>
                </div>
            </div>
            
            <!-- Confirmation -->
            <div>
                <label class="flex items-center">
                    <input type="checkbox" required class="w-4 h-4">
                    <span class="ml-2 text-gray-700">
                        I confirm this recording has been uploaded to Vimeo and is ready to share
                    </span>
                </label>
            </div>
            
            <!-- Action Buttons -->
            <div class="flex gap-4 pt-4">
                <button class="flex-1 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-bold">
                    Send Email to All
                </button>
                <a href="/admin" class="flex-1 py-3 border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-bold text-center">
                    Cancel
                </a>
            </div>
            
            <p class="text-xs text-gray-600 text-center">
                This will send to all 32 recipients. This action cannot be undone.
            </p>
        </div>
    </div>
</section>
