@{
    ViewBag.Title = "Create Webinar";
}

<section class="bg-white border-b border-gray-200 py-8">
    <div class="container mx-auto px-4">
        <a href="/admin/webinars" class="text-primary-600 hover:text-primary-700 font-semibold text-sm">← Back to Webinars</a>
        <h1 class="text-3xl font-bold text-gray-900 mt-2">Create New Webinar</h1>
    </div>
</section>

<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4 max-w-3xl">
        
        <form method="post" action="/admin/webinars/save" class="bg-white rounded-lg shadow p-8 space-y-6">
            
            <!-- Title -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">Title *</label>
                <input type="text" name="title" required placeholder="Enter webinar title"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
            </div>
            
            <!-- Description -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">Description *</label>
                <textarea name="description" required rows="5" placeholder="Full webinar description..."
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"></textarea>
            </div>
            
            <!-- Category -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">Category *</label>
                <select name="category" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                    <option value="">Select category...</option>
                    <option value="educators">For Educators</option>
                    <option value="parents">For Parents</option>
                    <option value="children">For Children</option>
                    <option value="general">General</option>
                </select>
            </div>
            
            <!-- Date/Time -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">Start Date & Time *</label>
                    <input type="datetime-local" name="startDate" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">End Date & Time *</label>
                    <input type="datetime-local" name="endDate" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                </div>
            </div>
            
            <!-- Price & Capacity -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">Price (ZAR) *</label>
                    <input type="number" name="price" required step="0.01" min="0" placeholder="150"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">Max Capacity *</label>
                    <input type="number" name="capacity" required min="1" placeholder="30"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                </div>
            </div>
            
            <!-- CPD Points -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">CPD Points Awarded *</label>
                <input type="number" name="cpdPoints" required min="1" placeholder="5"
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
            </div>
            
            <!-- Meeting Link -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-2">Zoom/Teams Join Link (Optional)</label>
                <input type="url" name="joinUrl" placeholder="https://zoom.us/..."
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
            </div>
            
            <!-- Status -->
            <div>
                <label class="block text-sm font-semibold text-gray-900 mb-3">Status *</label>
                <div class="space-y-2">
                    <label class="flex items-center">
                        <input type="radio" name="status" value="draft" checked class="w-4 h-4">
                        <span class="ml-2 text-gray-900">Draft (not visible to users)</span>
                    </label>
                    <label class="flex items-center">
                        <input type="radio" name="status" value="published" class="w-4 h-4">
                        <span class="ml-2 text-gray-900">Published (visible to users)</span>
                    </label>
                </div>
            </div>
            
            <!-- Buttons -->
            <div class="flex gap-4 pt-6 border-t border-gray-200">
                <button type="submit" class="flex-1 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-bold">
                    Save Webinar
                </button>
                <a href="/admin/webinars" class="flex-1 py-3 border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-bold text-center">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</section>
