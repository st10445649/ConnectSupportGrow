@{
    ViewBag.Title = "Manage Webinars";
}

<section class="bg-white border-b border-gray-200 py-8">
    <div class="container mx-auto px-4 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Manage Webinars</h1>
            <p class="text-gray-700">Create, edit, and manage all webinars</p>
        </div>
        <a href="/admin/webinars/create" class="px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-bold">
            + Create Webinar
        </a>
    </div>
</section>

<section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4">
        
        <!-- Filters -->
        <div class="bg-white rounded-lg shadow p-4 mb-6 flex gap-4 flex-wrap">
            <input type="text" placeholder="Search by title..."
                class="flex-1 min-w-48 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
            <select class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                <option>All Statuses</option>
                <option>Draft</option>
                <option>Published</option>
                <option>Cancelled</option>
            </select>
            <select class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                <option>Sort by Date</option>
                <option>Sort by Title</option>
                <option>Sort by Price</option>
            </select>
        </div>
        
        <!-- Webinars Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-100 border-b-2 border-gray-300">
                        <tr>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Title</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Date</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Price</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Capacity</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Status</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-gray-200 hover:bg-gray-50">
                            <td class="px-6 py-4 font-semibold text-gray-900">Autism Spectrum Awareness</td>
                            <td class="px-6 py-4 text-gray-700">July 15, 2026</td>
                            <td class="px-6 py-4 font-semibold">R150</td>
                            <td class="px-6 py-4">12 / 30</td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold">Published</span>
                            </td>
                            <td class="px-6 py-4 text-sm space-x-2">
                                <a href="#" class="text-primary-600 hover:text-primary-700 font-semibold">Edit</a>
                                <a href="#" class="text-red-600 hover:text-red-700 font-semibold">Delete</a>
                            </td>
                        </tr>
                        <tr class="border-b border-gray-200 hover:bg-gray-50">
                            <td class="px-6 py-4 font-semibold text-gray-900">Dyslexia: Identification & Intervention</td>
                            <td class="px-6 py-4 text-gray-700">July 22, 2026</td>
                            <td class="px-6 py-4 font-semibold">R200</td>
                            <td class="px-6 py-4">25 / 30</td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold">Published</span>
                            </td>
                            <td class="px-6 py-4 text-sm space-x-2">
                                <a href="#" class="text-primary-600 hover:text-primary-700 font-semibold">Edit</a>
                                <a href="#" class="text-red-600 hover:text-red-700 font-semibold">Delete</a>
                            </td>
                        </tr>
                        <tr class="border-b border-gray-200 hover:bg-gray-50">
                            <td class="px-6 py-4 font-semibold text-gray-900">Speech Delay: Parent Guide</td>
                            <td class="px-6 py-4 text-gray-700">July 29, 2026</td>
                            <td class="px-6 py-4 font-semibold">R100</td>
                            <td class="px-6 py-4">0 / 20</td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-semibold">Published (Full)</span>
                            </td>
                            <td class="px-6 py-4 text-sm space-x-2">
                                <a href="#" class="text-primary-600 hover:text-primary-700 font-semibold">Edit</a>
                                <a href="#" class="text-red-600 hover:text-red-700 font-semibold">Delete</a>
                            </td>
                        </tr>
                        <tr class="border-b border-gray-200 hover:bg-gray-50">
                            <td class="px-6 py-4 font-semibold text-gray-900">New Webinar Draft</td>
                            <td class="px-6 py-4 text-gray-700">August 5, 2026</td>
                            <td class="px-6 py-4 font-semibold">R150</td>
                            <td class="px-6 py-4">0 / 40</td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-semibold">Draft</span>
                            </td>
                            <td class="px-6 py-4 text-sm space-x-2">
                                <a href="#" class="text-primary-600 hover:text-primary-700 font-semibold">Edit</a>
                                <a href="#" class="text-red-600 hover:text-red-700 font-semibold">Delete</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
