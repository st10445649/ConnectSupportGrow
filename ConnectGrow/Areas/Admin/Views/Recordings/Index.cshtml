@{
    ViewBag.Title = "Manage Recording Access";
}

<section class="bg-white border-b border-gray-200 py-8">
    <div class="container mx-auto px-4">
        <h1 class="text-3xl font-bold text-gray-900">Manage Recording Access</h1>
        <p class="text-gray-700">Grant access to webinar recordings and manage expiry dates</p>
    </div>
</section>

<section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4 max-w-4xl">
        
        <!-- Webinar Selector -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
            <label class="block text-sm font-semibold text-gray-900 mb-2">Select Webinar</label>
            <select class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                <option>Choose a webinar...</option>
                <option selected>Autism Spectrum Awareness (July 15, 2026)</option>
                <option>Dyslexia: Identification & Intervention (July 22, 2026)</option>
                <option>AAC Basics (June 28, 2026)</option>
            </select>
        </div>
        
        <!-- Grant Access Form -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Grant Recording Access</h2>
            <form class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">User Email</label>
                    <input type="email" placeholder="user@example.com"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-900 mb-2">Access Expires</label>
                    <input type="date" value="2026-08-15"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
                </div>
                <button type="submit" class="w-full py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-bold">
                    Grant Access
                </button>
            </form>
        </div>
        
        <!-- Users with Access -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-bold text-gray-900">Users with Recording Access</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-100 border-b">
                        <tr>
                            <th class="px-6 py-3 text-left font-semibold text-gray-900">Name</th>
                            <th class="px-6 py-3 text-left font-semibold text-gray-900">Email</th>
                            <th class="px-6 py-3 text-left font-semibold text-gray-900">Booked</th>
                            <th class="px-6 py-3 text-left font-semibold text-gray-900">Expires</th>
                            <th class="px-6 py-3 text-left font-semibold text-gray-900">Status</th>
                            <th class="px-6 py-3 text-left font-semibold text-gray-900">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b hover:bg-gray-50">
                            <td class="px-6 py-3 font-semibold text-gray-900">Sarah Johnson</td>
                            <td class="px-6 py-3 text-gray-700">sarah@example.com</td>
                            <td class="px-6 py-3 text-gray-700">July 10</td>
                            <td class="px-6 py-3 text-gray-700">July 28</td>
                            <td class="px-6 py-3"><span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs font-semibold">Active</span></td>
                            <td class="px-6 py-3 text-sm"><a href="#" class="text-red-600 hover:text-red-700">Revoke</a></td>
                        </tr>
                        <tr class="border-b hover:bg-gray-50">
                            <td class="px-6 py-3 font-semibold text-gray-900">Michael Chen</td>
                            <td class="px-6 py-3 text-gray-700">michael@example.com</td>
                            <td class="px-6 py-3 text-gray-700">July 11</td>
                            <td class="px-6 py-3 text-gray-700">Aug 15</td>
                            <td class="px-6 py-3"><span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs font-semibold">Active</span></td>
                            <td class="px-6 py-3 text-sm"><a href="#" class="text-red-600 hover:text-red-700">Revoke</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
