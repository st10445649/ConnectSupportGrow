@{
    ViewBag.Title = "Manage Blog";
}

<section class="bg-white border-b border-gray-200 py-8">
    <div class="container mx-auto px-4 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Manage Blog</h1>
            <p class="text-gray-700">Create, edit, and organize blog posts</p>
        </div>
        <a href="/admin/blog/create" class="px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 font-bold">
            + New Post
        </a>
    </div>
</section>

<section class="py-8 bg-gray-50">
    <div class="container mx-auto px-4">
        
        <!-- Filters -->
        <div class="bg-white rounded-lg shadow p-4 mb-6 flex gap-4 flex-wrap">
            <input type="text" placeholder="Search posts..."
                class="flex-1 min-w-48 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500">
            <select class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                <option>All Categories</option>
                <option>Autism</option>
                <option>Speech & Language</option>
                <option>Inclusive Education</option>
            </select>
            <select class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 bg-white">
                <option>All Status</option>
                <option>Draft</option>
                <option>Published</option>
            </select>
        </div>
        
        <!-- Posts Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-100 border-b-2 border-gray-300">
                        <tr>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Title</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Category</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Published</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Status</th>
                            <th class="px-6 py-4 text-left font-semibold text-gray-900">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-gray-200 hover:bg-gray-50">
                            <td class="px-6 py-4 font-semibold text-gray-900">Creating Sensory-Friendly Classrooms</td>
                            <td class="px-6 py-4 text-gray-700">Autism</td>
                            <td class="px-6 py-4 text-gray-700">June 20, 2026</td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold">Published</span>
                            </td>
                            <td class="px-6 py-4 text-sm space-x-2">
                                <a href="#" class="text-primary-600 hover:text-primary-700 font-semibold">Edit</a>
                                <a href="#" class="text-red-600 hover:text-red-700 font-semibold">Delete</a>
                            </td>
                        </tr>
                        <tr class="border-b border-gray-200 hover:bg-gray-50">
                            <td class="px-6 py-4 font-semibold text-gray-900">Early Intervention for Speech Delays</td>
                            <td class="px-6 py-4 text-gray-700">Speech & Language</td>
                            <td class="px-6 py-4 text-gray-700">June 10, 2026</td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold">Published</span>
                            </td>
                            <td class="px-6 py-4 text-sm space-x-2">
                                <a href="#" class="text-primary-600 hover:text-primary-700 font-semibold">Edit</a>
                                <a href="#" class="text-red-600 hover:text-red-700 font-semibold">Delete</a>
                            </td>
                        </tr>
                        <tr class="border-b border-gray-200 hover:bg-gray-50">
                            <td class="px-6 py-4 font-semibold text-gray-900">Neurodiversity-Affirming Practices (Draft)</td>
                            <td class="px-6 py-4 text-gray-700">Inclusive Education</td>
                            <td class="px-6 py-4 text-gray-700">-</td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-semibold">Draft</span>
                            </td>
                            <td class="px-6 py-4 text-sm space-x-2">
                                <a href="#" class="text-primary-600 hover:text-primary-700 font-semibold">Edit</a>
                                <a href="#" class="text-red-600 hover:text-red-700 font-semibold">Delete</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
